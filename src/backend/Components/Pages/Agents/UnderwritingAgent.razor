@page "/agents/underwriting"

<PageTitle>Underwriting Agent — Advice Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #10b981">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the agent console</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">🩺</div>
        <div>
            <div class="agent-header-dept">Underwriting &amp; New Business · Protection Advice</div>
            <h1>Underwriting Agent</h1>
            <div class="agent-header-persona">Uma — Underwriting Coordinator</div>
            <p class="tagline">Answer every question carefully — it protects your claim later.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #10b981">
    <section class="panel uw-panel" style="--accent: #10b981">
        <!-- Step 1 — pick a case -->
        <div class="uw-step" data-step="1">
            <div class="uw-step-head">
                <span class="uw-step-num">1</span>
                <h3>Pick a Client Case</h3>
            </div>
            <div class="uw-pick">
                <label for="uw-case-select">Case</label>
                <select id="uw-case-select">
                    <option value="">— Loading cases —</option>
                </select>
                <button type="button" id="uw-refresh-btn" class="uw-refresh" title="Reload the list of cases">↻</button>
            </div>
            <p class="muted uw-empty" id="uw-empty" hidden>
                No cases yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a>, then come back here.
            </p>
            <div class="uw-case-summary" id="uw-case-summary" hidden></div>
            <div class="uw-note" id="uw-note" hidden>
                <div class="uw-note-title">Not an underwriting case</div>
                <p id="uw-note-text"></p>
                <div class="uw-note-links" id="uw-note-links"></div>
            </div>
            <div id="uw-load-status" class="uw-status" hidden></div>
        </div>

        <!-- Step 2 — insurer and requirements -->
        <div class="uw-step" data-step="2" id="uw-insurer-step" hidden>
            <div class="uw-step-head">
                <span class="uw-step-num">2</span>
                <h3>Insurer and requirements</h3>
            </div>
            <p class="muted" id="uw-plan-status"></p>
            <div class="uw-insurer" id="uw-insurer"></div>

            <h4 class="uw-subhead">Covers on the application</h4>
            <div class="uw-table-wrap"><table class="uw-table" id="uw-covers"></table></div>
            <p class="uw-premium-note" id="uw-premium-note"></p>

            <h4 class="uw-subhead">Evidence needed for each life insured's age and sum insured</h4>
            <div class="uw-lives" id="uw-lives"></div>
            <div class="uw-table-wrap"><table class="uw-table" id="uw-requirements"></table></div>
        </div>

        <!-- Step 3 — disclosure checklist -->
        <div class="uw-step" data-step="3" id="uw-disclosure-step" hidden>
            <div class="uw-step-head">
                <span class="uw-step-num">3</span>
                <h3>Disclosure checklist</h3>
            </div>
            <div class="uw-duty">
                <div class="uw-duty-label">Duty to take reasonable care — read before the health questions</div>
                <blockquote id="uw-duty-script"></blockquote>
                <div class="uw-duty-ack" id="uw-duty-ack"></div>
            </div>
            <ul class="uw-disclosures" id="uw-disclosures"></ul>
        </div>

        <!-- Step 4 — engage and generate the PDF -->
        <div class="uw-step" data-step="4" id="uw-engage-step" hidden>
            <div class="uw-step-head">
                <span class="uw-step-num">4</span>
                <h3>Engage the Underwriting Agent — application summary PDF</h3>
            </div>
            <button id="uw-process-btn" type="button" disabled>Engage the Underwriting Agent and generate the PDF</button>
            <div id="uw-process-status" class="uw-status" hidden></div>

            <div class="uw-pdf" id="uw-pdf" hidden>
                <div class="uw-pdf-label">Application and disclosure summary</div>
                <div class="uw-pdf-row">
                    <span class="uw-pdf-icon" aria-hidden="true">📄</span>
                    <div class="uw-pdf-meta">
                        <div class="uw-pdf-name" id="uw-pdf-name"></div>
                        <div class="uw-pdf-sub" id="uw-pdf-sub"></div>
                    </div>
                    <a id="uw-pdf-open" class="uw-pdf-btn" href="#" target="_blank" rel="noopener">Open</a>
                    <a id="uw-pdf-link" class="uw-pdf-btn" href="#" download>Download PDF</a>
                </div>
            </div>

            <div class="engage-tabs-scope" data-engage-role="underwriting">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 5 — timeline and decision -->
        <div class="uw-step" data-step="5" id="uw-timeline-step" hidden>
            <div class="uw-step-head">
                <span class="uw-step-num">5</span>
                <h3>Underwriting timeline and decision</h3>
            </div>
            <div class="uw-two-col">
                <div>
                    <h4 class="uw-subhead">Timeline</h4>
                    <ol class="uw-timeline" id="uw-timeline"></ol>
                    <div class="uw-sla" id="uw-sla"></div>
                </div>
                <div>
                    <h4 class="uw-subhead">The insurer's decision, in plain English</h4>
                    <p class="uw-decision-summary" id="uw-decision-summary"></p>
                    <div id="uw-decisions"></div>
                </div>
            </div>
        </div>

        <!-- Step 6 — client decision with the adviser -->
        <div class="uw-step" data-step="6" id="uw-client-step" hidden>
            <div class="uw-step-head">
                <span class="uw-step-num">6</span>
                <h3>Client decision with the adviser</h3>
            </div>
            <div class="uw-client" id="uw-client">
                <div class="uw-client-head">
                    <span class="uw-pill" id="uw-client-pill"></span>
                    <span class="uw-client-who" id="uw-client-who"></span>
                </div>
                <p id="uw-client-summary"></p>
                <ul id="uw-client-points"></ul>
                <div class="uw-callout info" id="uw-cooling-off"></div>
                <div class="uw-callout ok" id="uw-existing-cover"></div>
            </div>
            <div class="uw-approval" id="uw-approval">
                <span class="uw-approval-pill" id="uw-approval-pill"></span>
                <span id="uw-approval-reason"></span>
            </div>
            <p class="approval uw-approval-note">
                Uma's agent prepares, explains and tracks. Accepting a loading, an exclusion or a decline is always the
                client's decision with Amelia, and existing cover is never cancelled before the new cover is accepted and in force.
            </p>
        </div>
    </section>
</div>

<style>
    .uw-panel { --uw-accent: #10b981; }
    .uw-panel a { color: #0e6f4f; }

    .uw-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .uw-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .uw-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .uw-step-num {
        display: inline-grid; place-items: center; width: 1.55rem; height: 1.55rem; border-radius: 50%;
        background: color-mix(in srgb, #10b981 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, #10b981 55%, transparent);
        color: #0e6f4f; font-size: 0.78rem; font-weight: 700;
    }
    .uw-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }
    .uw-subhead { margin: 1rem 0 0.45rem 0; font-size: 0.88rem; color: #1d2939; }

    .uw-pick { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .uw-pick label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cw-muted, #5d6b7e); font-weight: 700; }
    .uw-pick select {
        background: #fff; border: 1px solid rgba(16, 38, 72, 0.136); border-radius: 6px;
        color: #0b1f3a; font-size: 0.9rem; padding: 0.5rem 0.7rem; min-width: 320px; max-width: 100%;
    }
    .uw-pick select:focus { outline: none; border-color: #10b981; box-shadow: 0 0 0 3px color-mix(in srgb, #10b981 25%, transparent); }
    .uw-refresh { background: transparent; color: #344054; border: 1px solid rgba(16, 38, 72, 0.198); border-radius: 6px; padding: 0.4rem 0.7rem; font-size: 1rem; cursor: pointer; }
    .uw-refresh:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .uw-case-summary {
        margin-top: 0.7rem; background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.112); border-radius: 8px;
        padding: 0.7rem 0.85rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 0.5rem 1rem; font-size: 0.85rem; color: #344054;
    }
    .uw-case-summary .k { display: block; font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cw-muted, #5d6b7e); font-weight: 700; margin-bottom: 0.15rem; }
    .uw-case-summary .wide { grid-column: 1 / -1; }

    .uw-note {
        margin-top: 0.8rem; padding: 0.8rem 1rem; border-radius: 10px;
        background: rgba(201, 161, 74, 0.1); border: 1px solid rgba(201, 161, 74, 0.45);
        color: #5c4512; font-size: 0.9rem;
    }
    .uw-note-title { font-weight: 700; color: #3f2f08; margin-bottom: 0.25rem; }
    .uw-note p { margin: 0 0 0.55rem 0; line-height: 1.55; }
    .uw-note-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .uw-note-links a {
        display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px; background: #fff;
        border: 1px solid rgba(201, 161, 74, 0.6); color: #5c4512 !important; font-weight: 600; font-size: 0.82rem; text-decoration: none;
    }

    .uw-status { margin-top: 0.6rem; font-size: 0.88rem; color: #344054; }
    .uw-status.error { color: #c11818; }
    .uw-status.warn { color: #954f12; }
    .uw-status .spinner {
        display: inline-block; width: 12px; height: 12px; border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle; animation: uw-spin 0.7s linear infinite;
    }
    @@keyframes uw-spin { to { transform: rotate(360deg); } }

    /* Insurer card */
    .uw-insurer {
        display: grid; grid-template-columns: 1.1fr 1fr; gap: 0.5rem 1.2rem;
        background: color-mix(in srgb, #10b981 7%, #fff);
        border: 1px solid color-mix(in srgb, #10b981 30%, transparent);
        border-radius: 10px; padding: 0.8rem 1rem; font-size: 0.85rem; color: #344054;
    }
    @@media (max-width: 820px) { .uw-insurer { grid-template-columns: 1fr; } }
    .uw-insurer-name { font-size: 1.05rem; font-weight: 700; color: #0b1f3a; }
    .uw-insurer-prefix { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: #126f4a; font-size: 0.8rem; margin-left: 0.35rem; }
    .uw-insurer .k { display: block; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cw-muted, #5d6b7e); font-weight: 700; margin-top: 0.45rem; }
    .uw-insurer ul { margin: 0.15rem 0 0; padding-left: 1.05rem; }
    .uw-insurer li { margin-bottom: 0.15rem; }

    .uw-table-wrap { overflow-x: auto; contain: inline-size; }
    .uw-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; color: #1d2939; background: #fff; }
    .uw-table th, .uw-table td { padding: 0.42rem 0.55rem; border-bottom: 1px solid rgba(16, 38, 72, 0.099); text-align: left; vertical-align: top; }
    .uw-table th { color: var(--cw-muted, #5d6b7e); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.07em; font-weight: 700; }
    .uw-table .num { text-align: right; white-space: nowrap; }
    .uw-table .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.76rem; margin: 0; }
    .uw-premium-note { font-size: 0.84rem; color: #344054; margin: 0.45rem 0 0; }

    .uw-lives { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.5rem; margin-bottom: 0.55rem; }
    .uw-life { background: #fff; border: 1px solid rgba(16, 38, 72, 0.11); border-radius: 8px; padding: 0.55rem 0.75rem; font-size: 0.82rem; color: #344054; }
    .uw-life-name { font-weight: 700; color: #0b1f3a; font-size: 0.9rem; }
    .uw-life-sums { margin-top: 0.25rem; font-variant-numeric: tabular-nums; }

    .uw-pill {
        display: inline-block; border-radius: 999px; padding: 0.08rem 0.55rem;
        font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        border: 1px solid currentColor; white-space: nowrap;
    }
    .uw-pill.ok { color: #126f4a; background: rgba(16, 185, 129, 0.12); }
    .uw-pill.warn { color: #954f12; background: rgba(245, 158, 11, 0.12); }
    .uw-pill.blocked { color: #c11818; background: rgba(239, 68, 68, 0.12); }
    .uw-pill.info { color: #126891; background: rgba(14, 165, 233, 0.12); }

    /* Disclosure checklist */
    .uw-duty {
        border-radius: 10px; padding: 0.75rem 0.95rem;
        background: rgba(14, 165, 233, 0.07); border: 1px solid rgba(14, 165, 233, 0.35);
    }
    .uw-duty-label { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: #126794; font-weight: 700; }
    .uw-duty blockquote { margin: 0.4rem 0 0.4rem; padding: 0 0 0 0.7rem; border-left: 3px solid rgba(14, 165, 233, 0.6); color: #1d2939; font-size: 0.9rem; line-height: 1.55; }
    .uw-duty-ack { font-size: 0.84rem; font-weight: 600; color: #0b1f3a; }
    .uw-disclosures { list-style: none; margin: 0.7rem 0 0; padding: 0; }
    .uw-disclosures li {
        display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; padding: 0.5rem 0.6rem; margin-bottom: 0.4rem;
        border-radius: 8px; background: #fff; border: 1px solid rgba(16, 38, 72, 0.087); font-size: 0.86rem;
    }
    .uw-disclosures li.done { border-left: 3px solid #34d399; }
    .uw-disclosures li.disclosed { border-left: 3px solid #60a5fa; }
    .uw-disclosures li.action { border-left: 3px solid #f59e0b; background: rgba(245, 158, 11, 0.05); }
    .uw-disclosures li.info { border-left: 3px solid #c9a14a; }
    .uw-disclosures .icon { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.75rem; background: rgba(16, 38, 72, 0.06); }
    .uw-disclosures .label { font-weight: 600; color: #0b1f3a; }
    .uw-disclosures .state { font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cw-muted, #5d6b7e); margin-left: 0.4rem; }
    .uw-disclosures .detail { color: #344054; font-size: 0.84rem; margin-top: 0.15rem; line-height: 1.5; }

    #uw-process-btn {
        background: var(--cw-primary); color: #fff; border: none; border-radius: 999px;
        padding: 0.5rem 1rem; font-size: 0.88rem; font-weight: 700; cursor: pointer; margin-top: 0.35rem;
    }
    #uw-process-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .uw-panel .engage-narrative-body { contain: inline-size; overflow-x: auto; }

    .uw-pdf {
        margin-top: 0.7rem; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.35);
        border-radius: 8px; padding: 0.7rem 0.85rem;
    }
    .uw-pdf-label { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--cw-muted, #5d6b7e); font-weight: 700; margin-bottom: 0.45rem; }
    .uw-pdf-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .uw-pdf-icon { font-size: 1.6rem; }
    .uw-pdf-meta { flex: 1; min-width: 0; contain: inline-size; }
    .uw-pdf-name { color: #0b1f3a; font-weight: 600; font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .uw-pdf-sub { color: var(--cw-muted, #5d6b7e); font-size: 0.78rem; margin-top: 0.1rem; }
    .uw-pdf-btn {
        background: #fff; color: var(--cw-primary); border-radius: 999px; padding: 0.4rem 0.85rem;
        font-size: 0.82rem; font-weight: 700; text-decoration: none; white-space: nowrap;
        border: 1px solid color-mix(in srgb, var(--cw-primary) 40%, transparent);
    }

    /* Timeline and decision */
    .uw-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1.4rem; }
    @@media (max-width: 900px) { .uw-two-col { grid-template-columns: 1fr; } }
    .uw-timeline { list-style: none; margin: 0; padding: 0 0 0 0.9rem; border-left: 2px solid rgba(16, 185, 129, 0.35); }
    .uw-timeline li { position: relative; padding: 0 0 0.6rem 0.6rem; font-size: 0.85rem; color: #344054; }
    .uw-timeline li::before {
        content: ''; position: absolute; left: -1.27rem; top: 0.3rem; width: 0.7rem; height: 0.7rem; border-radius: 50%;
        background: #fff; border: 2px solid #10b981;
    }
    .uw-timeline li.warn::before { border-color: #f59e0b; }
    .uw-timeline li.human::before { background: #c9a14a; border-color: #c9a14a; }
    .uw-timeline .date { font-weight: 700; color: #0b1f3a; font-size: 0.8rem; }
    .uw-timeline .who { color: var(--cw-muted, #5d6b7e); font-size: 0.76rem; }
    .uw-timeline .human-tag { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #8a6a1d; margin-left: 0.35rem; }
    .uw-sla { font-size: 0.8rem; color: var(--cw-muted, #5d6b7e); margin-top: 0.2rem; }
    .uw-decision-summary { font-size: 0.86rem; color: #1d2939; line-height: 1.5; margin: 0 0 0.5rem; }
    .uw-decision {
        background: #fff; border: 1px solid rgba(16, 38, 72, 0.1); border-radius: 8px; padding: 0.55rem 0.7rem; margin-bottom: 0.45rem;
    }
    .uw-decision.warn { border-left: 3px solid #f59e0b; }
    .uw-decision.ok { border-left: 3px solid #34d399; }
    .uw-decision.info { border-left: 3px solid #60a5fa; }
    .uw-decision-head { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
    .uw-decision-cover { font-weight: 600; color: #0b1f3a; font-size: 0.86rem; }
    .uw-decision-who { font-size: 0.76rem; color: var(--cw-muted, #5d6b7e); }
    .uw-decision p { margin: 0.25rem 0 0; font-size: 0.84rem; color: #344054; line-height: 1.5; }

    /* Client decision */
    .uw-client {
        border-radius: 12px; padding: 0.9rem 1rem;
        background: linear-gradient(180deg, rgba(201, 161, 74, 0.1), rgba(201, 161, 74, 0.03));
        border: 1px solid rgba(201, 161, 74, 0.55); font-size: 0.88rem; color: #344054;
    }
    .uw-client-head { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    .uw-client-who { font-weight: 700; color: #3f2f08; }
    .uw-client p { margin: 0.5rem 0; line-height: 1.55; }
    .uw-client ul { margin: 0 0 0.5rem; padding-left: 1.1rem; }
    .uw-client li { margin-bottom: 0.25rem; }
    .uw-callout { border-radius: 8px; padding: 0.55rem 0.8rem; font-size: 0.85rem; margin-top: 0.4rem; }
    .uw-callout.info { background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.35); color: #126794; }
    .uw-callout.ok { background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.35); color: #0f5f43; }
    .uw-approval {
        margin-top: 0.8rem; border-radius: 8px; padding: 0.55rem 0.8rem; font-size: 0.86rem;
