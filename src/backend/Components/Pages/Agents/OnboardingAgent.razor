@page "/agents/onboarding"

<PageTitle>Onboarding Agent — Advice Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #0ea5e9">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the agent console</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">📥</div>
        <div>
            <div class="agent-header-dept">Onboarding &amp; Requests</div>
            <h1>Onboarding Agent</h1>
            <div class="agent-header-persona">Olivia — Onboarding &amp; Requests Officer</div>
            <p class="tagline">Every enquiry, referral and claim, set up right the first time.</p>
            <div class="agent-header-tags">
                <span class="agent-header-tag">Discover · Verify</span>
                <span class="agent-header-tag side-shared">Shared by both sides</span>
            </div>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #0ea5e9">
    <section class="panel intake-panel" style="--accent: #0ea5e9">
        <!-- Step 1 — pick a sample inbound request -->
        <div class="intake-step" data-step="1">
            <div class="intake-step-head">
                <span class="intake-step-num">1</span>
                <h3>Pick an inbound request</h3>
            </div>
            <p class="muted">Referral emails, an urgent claim email, a call note and a death notification — one for each scenario.</p>
            <div class="intake-samples" id="intake-samples"></div>
            <div class="intake-preview" id="intake-preview" hidden>
                <div class="intake-preview-grid">
                    <div>
                        <div class="intake-preview-label">Email or call note</div>
                        <div class="intake-preview-meta">
                            <div><span class="k">From</span><span id="intake-email-from"></span></div>
                            <div><span class="k">Date</span><span id="intake-email-date"></span></div>
                            <div><span class="k">Subject</span><span id="intake-email-subject"></span></div>
                        </div>
                        <pre class="intake-preview-body" id="intake-email-body"></pre>
                    </div>
                    <div>
                        <div class="intake-preview-label">📎 Attachment — <span id="intake-form-name"></span></div>
                        <pre class="intake-preview-body intake-form-doc" id="intake-form-body"></pre>
                    </div>
                </div>
                <div class="intake-file">
                    <div class="intake-preview-label">🗂️ On file at Caldova</div>
                    <pre class="intake-preview-body intake-file-body" id="intake-file-body"></pre>
                </div>
            </div>
        </div>

        <!-- Step 2 — engage the agent -->
        <div class="intake-step" data-step="2" id="intake-step-2" hidden>
            <div class="intake-step-head">
                <span class="intake-step-num">2</span>
                <h3>Engage the Onboarding Agent</h3>
            </div>
            <button id="intake-process-btn" type="button" disabled>Process with the Onboarding Agent</button>
            <div id="intake-process-status" class="intake-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="onboarding">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3 — review the Client Case, fact find, checklist and priority -->
        <div class="intake-step" data-step="3" id="intake-step-3" hidden>
            <div class="intake-step-head">
                <span class="intake-step-num">3</span>
                <h3>Review the Client Case</h3>
            </div>
            <p class="muted">Everything is editable — Olivia checks it before the case opens.</p>
            <div class="intake-form-wrap" id="intake-form-wrap" hidden>
                <form id="intake-form" class="intake-form" autocomplete="off">
                    <div class="intake-subhead">Client Case</div>
                    <div class="intake-grid">
                        <label>Client name<input name="clientName" required /></label>
                        <label>Client number<input name="clientNumber" required /></label>
                        <label>Client email<input type="email" name="clientEmail" /></label>
                        <label>Client phone<input name="clientPhone" /></label>
                        <label>
                            Request type
                            <select name="requestType" id="intake-request-type">
                                @foreach (var requestType in RequestTypeOptions)
                                {
                                    <option value="@requestType">@requestType</option>
                                }
                            </select>
                        </label>
                        <label>Received date<input type="text" name="receivedDate" placeholder="YYYY-MM-DD" /></label>
                        <label class="span-2">Cover<input name="cover" /></label>
                        <label>Headline amount<input name="amount" /></label>
                        <label>Adviser<input name="adviserName" /></label>
                        <label>Referred by<input name="referredBy" /></label>
                        <label>Preferred contact<input name="preferredContact" /></label>
                        <label class="span-2">Request summary<textarea name="requestSummary" rows="4"></textarea></label>
                    </div>

                    <div class="intake-factfind" id="intake-factfind">
                        <div class="intake-check-head">
                            <span class="intake-subhead" id="intake-factfind-title">Fact find</span>
                            <span class="intake-factfind-note">🔒 Health information is shared only with the people who need it.</span>
                        </div>
                        <dl class="intake-factfind-list" id="intake-factfind-list"></dl>
                    </div>

                    <div class="intake-check" id="intake-check">
                        <div class="intake-check-head">
                            <span class="intake-subhead">In-good-order checklist</span>
                            <span class="intake-check-summary" id="intake-check-summary"></span>
                        </div>
                        <p class="muted intake-check-help">✅ in good order · ⚠️ needs action</p>
                        <ul class="intake-check-list" id="intake-check-list"></ul>
                    </div>

                    <div class="intake-priority" id="intake-priority" hidden>
                        <div class="intake-priority-head">
                            <span class="intake-priority-title">Priority</span>
                            <select name="priority" id="intake-priority-select" aria-label="Priority">
                                <option value="Standard">Standard</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                            <span class="intake-priority-pill" id="intake-priority-pill"></span>
                        </div>
                        <textarea name="priorityReason" id="intake-priority-reason" rows="3" aria-label="Reason for the priority"></textarea>
                        <div class="intake-vuln" id="intake-vuln"></div>
                    </div>

                    <div class="intake-routing-preview" id="intake-routing-preview" hidden>
                        <div class="intake-subhead">Will be routed to</div>
                        <div class="other-agents" id="intake-routing-preview-list"></div>
                    </div>

                    <div class="intake-form-actions">
                        <button type="submit" id="intake-submit-btn">
                            <span class="intake-step-num inline">4</span>
                            Confirm &amp; open case
                        </button>
                        <span class="muted intake-submit-hint">Olivia confirms — the agent never opens a case on its own.</span>
                    </div>
                </form>
            </div>
        </div>

        <!-- Step 4 — case opened and routed -->
        <div class="intake-step intake-receipt" data-step="4" id="intake-receipt" hidden>
            <div class="intake-step-head">
                <span class="intake-step-num">4</span>
                <h3>Client Case opened</h3>
            </div>
            <div class="intake-receipt-body">
                <div class="intake-receipt-num" id="intake-receipt-num"></div>
                <div class="intake-receipt-meta" id="intake-receipt-meta"></div>
                <div class="intake-subhead">Routed to</div>
                <div class="intake-routes" id="intake-routes"></div>
                <div class="intake-outstanding" id="intake-outstanding" hidden></div>
                <p class="muted">Every agent page can now pick up this case.</p>
                <div class="intake-receipt-actions">
                    <button type="button" id="intake-reset-btn" class="intake-reset">Process another request</button>
                    <a id="intake-scenario-link" class="intake-scenario-link" href="/" hidden>See the whole scenario →</a>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .intake-panel { --intake-accent: #0ea5e9; }

    .other-agent.primary {
        border-color: color-mix(in srgb, #0ea5e9 60%, transparent);
        background: color-mix(in srgb, #0ea5e9 14%, rgba(16, 38, 72, 0.028));
        color: #0b1f3a;
    }

    .intake-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .intake-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .intake-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .intake-step-num {
        display: inline-grid; place-items: center;
        width: 1.55rem; height: 1.55rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--intake-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--intake-accent) 55%, transparent);
        color: color-mix(in srgb, var(--intake-accent) 60%, #0b1f3a);
        font-size: 0.78rem; font-weight: 700;
    }
    .intake-step-num.inline { margin-right: 0.45rem; vertical-align: middle; }
    .intake-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }

    .intake-subhead {
        display: block;
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
        margin: 0.2rem 0 0.5rem 0;
    }

    .intake-samples {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 0.6rem;
        margin-top: 0.5rem;
    }
    .intake-sample {
        text-align: left;
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 10px;
        padding: 0.7rem 0.85rem;
        color: #344054;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }
    .intake-sample:hover { border-color: color-mix(in srgb, var(--intake-accent) 45%, transparent); background: #f2f4f7; }
    .intake-sample.selected {
        border-color: var(--intake-accent);
        background: color-mix(in srgb, var(--intake-accent) 14%, #ffffff);
    }
    .intake-sample-label { font-weight: 700; color: #0b1f3a; font-size: 0.92rem; margin-bottom: 0.2rem; }
    .intake-sample-meta { font-size: 0.78rem; color: var(--cw-muted, #5d6b7e); }
    .intake-sample-meta .pill {
        display: inline-block;
        background: rgba(20, 184, 166, 0.10);
        border: 1px solid rgba(20, 184, 166, 0.32);
        color: #0f766e;
        padding: 0.05rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        margin-bottom: 0.25rem;
    }
    .intake-sample-meta .pill.claim {
        background: rgba(201, 161, 74, 0.12);
        border-color: rgba(201, 161, 74, 0.4);
        color: #7a5a14;
    }

    .intake-preview { margin-top: 0.8rem; }
    .intake-preview-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.7rem;
    }
    @@media (max-width: 820px) { .intake-preview-grid { grid-template-columns: 1fr; } }
    .intake-preview-label {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700; margin-bottom: 0.3rem;
    }
    .intake-preview-meta { font-size: 0.82rem; color: #344054; margin-bottom: 0.4rem; }
    .intake-preview-meta div { padding: 0.1rem 0; }
    .intake-preview-meta .k {
        display: inline-block; min-width: 60px;
        color: var(--cw-muted, #5d6b7e); font-weight: 600;
        text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.08em;
        margin-right: 0.5rem;
    }
    .intake-preview-body {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 8px;
        padding: 0.7rem 0.85rem;
        color: #344054;
        font-size: 0.82rem;
        line-height: 1.45;
        white-space: pre-wrap;
        max-height: 280px;
        overflow: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .intake-form-doc { background: rgba(16, 38, 72, 0.028); border-style: dashed; }
    .intake-file { margin-top: 0.7rem; }
    .intake-file-body {
        max-height: 200px;
        background: color-mix(in srgb, var(--intake-accent) 6%, #ffffff);
        border-color: color-mix(in srgb, var(--intake-accent) 28%, transparent);
    }

    .intake-status {
        margin-top: 0.6rem; font-size: 0.88rem;
        color: #344054;
    }
    .intake-status.error { color: #c11818; }
    .intake-status.warn { color: #954f12; }
    .intake-status .spinner {
        display: inline-block; width: 12px; height: 12px;
        border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle;
        animation: intake-spin 0.7s linear infinite;
    }
    @@keyframes intake-spin { to { transform: rotate(360deg); } }

    .intake-form-wrap { margin-top: 0.6rem; }
    .intake-form .intake-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.7rem 0.85rem;
    }
    @@media (max-width: 820px) { .intake-form .intake-grid { grid-template-columns: 1fr; } }
    .intake-form .span-2 { grid-column: span 2; }
    @@media (max-width: 820px) { .intake-form .span-2 { grid-column: span 1; } }
    .intake-form label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e);
        font-weight: 700;
    }
    .intake-form input,
    .intake-form textarea,
    .intake-form select {
        display: block; width: 100%;
        margin-top: 0.3rem;
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 6px;
        color: #0b1f3a;
        font-size: 0.9rem;
        padding: 0.55rem 0.7rem;
        font-family: inherit;
        text-transform: none;
        letter-spacing: normal;
    }
    .intake-form select option { background: #ffffff; color: #0b1f3a; }
    .intake-form input:focus,
    .intake-form textarea:focus,
    .intake-form select:focus {
        outline: none;
        border-color: var(--intake-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--intake-accent) 25%, transparent);
    }
    .intake-form textarea { resize: vertical; min-height: 70px; }

    /* Fact find (read-only) */
    .intake-factfind {
        margin-top: 1rem;
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
    }
    .intake-factfind-note { font-size: 0.78rem; color: var(--cw-muted, #5d6b7e); }
    .intake-factfind-list {
        display: grid;
        grid-template-columns: minmax(160px, 220px) 1fr;
        gap: 0.35rem 0.9rem;
        margin: 0.4rem 0 0 0;
        font-size: 0.88rem;
    }
    @@media (max-width: 720px) { .intake-factfind-list { grid-template-columns: 1fr; } }
    .intake-factfind-list dt { color: #475467; font-weight: 600; }
    .intake-factfind-list dd { margin: 0; color: #1d2939; }
    .intake-factfind-list dd.sensitive {
        background: rgba(139, 156, 247, 0.10);
        border-left: 3px solid #8b9cf7;
        padding: 0.1rem 0.5rem;
        border-radius: 0 6px 6px 0;
    }
    .intake-sensitive-tag {
        display: inline-block;
        margin-left: 0.4rem;
        font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: #4b55a8;
    }

    /* In-good-order checklist */
    .intake-check {
        margin-top: 1rem;
        background: #f9fafb;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
    }
    .intake-check-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap; }
    .intake-check-head .intake-subhead { margin: 0; }
    .intake-check-summary { font-size: 0.8rem; color: #344054; }
    .intake-check-summary .ok { color: #0f7032; font-weight: 700; }
    .intake-check-summary .action { color: #954f12; font-weight: 700; }
    .intake-step .muted.intake-check-help { margin: 0.25rem 0 0.6rem 0; font-size: 0.82rem; }
    .intake-check-list { list-style: none; margin: 0; padding: 0; }
    .intake-check-item {
        display: grid;
        grid-template-columns: 175px 1fr;
        gap: 0.7rem;
        align-items: start;
        padding: 0.5rem 0.6rem;
        margin-bottom: 0.4rem;
        border-radius: 8px;
        background: rgba(16, 38, 72, 0.025);
        border: 1px solid rgba(16, 38, 72, 0.087);
        border-left: 3px solid #34d399;
    }
    .intake-check-item.action { border-left-color: #fbbf24; background: rgba(245, 158, 11, 0.06); }
    @@media (max-width: 720px) { .intake-check-item { grid-template-columns: 1fr; } }
    .intake-form .intake-check-item select { margin-top: 0; padding: 0.4rem 0.5rem; font-size: 0.82rem; }
    .intake-check-label { color: #0b1f3a; font-weight: 600; font-size: 0.88rem; margin-bottom: 0.25rem; }
    .intake-form .intake-check-item textarea { margin-top: 0; padding: 0.4rem 0.55rem; font-size: 0.84rem; min-height: 0; resize: vertical; }

    /* Priority and vulnerability */
    .intake-priority {
        margin-top: 0.85rem;
        background: color-mix(in srgb, var(--intake-accent) 10%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--intake-accent) 35%, transparent);
        border-radius: 10px;
        padding: 0.7rem 0.9rem;
    }
    .intake-priority-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.45rem; flex-wrap: wrap; }
    .intake-priority-title { color: #0b1f3a; font-weight: 700; font-size: 0.92rem; }
    .intake-form .intake-priority-head select { width: auto; min-width: 150px; margin-top: 0; padding: 0.35rem 0.55rem; }
    .intake-priority-pill {
        margin-left: auto;
        padding: 0.15rem 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.1em;
    }
    .intake-priority-pill.urgent   { background: rgba(239, 68, 68, 0.18); color: #c11818; border: 1px solid rgba(239, 68, 68, 0.4); }
    .intake-priority-pill.high     { background: rgba(245, 158, 11, 0.18); color: #954f12; border: 1px solid rgba(245, 158, 11, 0.4); }
    .intake-priority-pill.standard { background: rgba(34, 197, 94, 0.16); color: #0f7032; border: 1px solid rgba(34, 197, 94, 0.4); }
    .intake-form .intake-priority textarea { margin-top: 0; min-height: 56px; font-size: 0.86rem; }
    .intake-vuln { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.55rem; font-size: 0.8rem; color: #344054; align-items: center; }
    .intake-vuln-chip {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        background: rgba(236, 72, 153, 0.10);
        border: 1px solid rgba(236, 72, 153, 0.35);
        color: #9d174d;
        font-weight: 600;
    }
    .intake-vuln-none { color: var(--cw-muted, #5d6b7e); }

    .intake-routing-preview { margin-top: 0.85rem; }
    .intake-routing-preview .other-agent { cursor: default; }

    .intake-form-actions {
        margin-top: 0.95rem;
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem;
    }
    .intake-form-actions button[type=submit] {
        background: var(--cw-primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: filter 0.15s ease, transform 0.15s ease;
    }
