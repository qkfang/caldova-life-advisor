@page "/agents/insurance-research"

<PageTitle>Insurance Research Agent — Advice Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #f59e0b">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the agent console</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">🔎</div>
        <div>
            <div class="agent-header-dept">Insurance Research · Protection Advice</div>
            <h1>Insurance Research Agent</h1>
            <div class="agent-header-persona">Ivy — Insurance Research Analyst</div>
            <p class="tagline">Cheapest isn't best if the definition won't pay.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #f59e0b">
    <section class="panel ir-panel" style="--accent: #f59e0b">
        <p class="ir-intro">
            Ivy's agent compares the insurers on Life Advice Guru's approved product list — definitions first, price second — and
            recommends to Penny and Amelia. Amelia gives the advice and signs the Statement of Advice; the agent never
            advises the client. For a claim, it looks up the policy wording and hands over to the Claims Agent.
        </p>

        <!-- Step 1 — pick a case -->
        <div class="ir-step" data-step="1">
            <div class="ir-step-head">
                <span class="ir-step-num">1</span>
                <h3>Pick a case</h3>
            </div>
            <div class="ir-case-row">
                <select id="ir-case-select" aria-label="Client Case">
                    <option value="">— Loading cases —</option>
                </select>
                <button type="button" id="ir-refresh-btn" class="ir-secondary" title="Reload the list of cases">↻ Refresh</button>
            </div>
            <p class="muted ir-empty" id="ir-empty" hidden>
                No cases yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a>, then come back here.
            </p>

            <div class="ir-case" id="ir-case" hidden>
                <div class="ir-case-card">
                    <div class="ir-case-top">
                        <div class="ir-case-num" id="ir-case-num"></div>
                        <span class="ir-pill" id="ir-case-kind"></span>
                        <span class="ir-pill ir-pill-status" id="ir-case-status" hidden></span>
                    </div>
                    <div class="ir-case-grid">
                        <div><span class="k">Client</span><span id="ir-case-client"></span></div>
                        <div><span class="k">Client no.</span><span id="ir-case-clientno"></span></div>
                        <div><span class="k">Request type</span><span id="ir-case-type"></span></div>
                        <div><span class="k">Received</span><span id="ir-case-received"></span></div>
                        <div><span class="k">Adviser</span><span id="ir-case-adviser"></span></div>
                        <div><span class="k">Referred by</span><span id="ir-case-referred"></span></div>
                        <div class="span-2"><span class="k">Cover</span><span id="ir-case-cover"></span></div>
                        <div class="span-2"><span class="k">Priority</span><span id="ir-case-priority"></span></div>
                    </div>
                </div>

                <div class="ir-note" id="ir-journey-note" hidden></div>

                <div class="ir-brief">
                    <div class="ir-brief-head">
                        <div class="ir-kicker">Research brief</div>
                        <div class="ir-brief-title" id="ir-brief-title"></div>
                        <div class="ir-brief-summary" id="ir-brief-summary"></div>
                    </div>
                    <div class="ir-two-col">
                        <div class="ir-subblock" id="ir-brief-facts-block">
                            <h4 class="ir-subhead">Key facts</h4>
                            <ul class="ir-list" id="ir-brief-facts"></ul>
                        </div>
                        <div class="ir-subblock" id="ir-brief-cover-block">
                            <h4 class="ir-subhead" id="ir-brief-cover-head">Cover to research — from Penny's needs analysis</h4>
                            <ul class="ir-list" id="ir-brief-cover"></ul>
                            <p class="ir-budget" id="ir-brief-budget" hidden></p>
                        </div>
                    </div>
                    <div class="ir-subblock" id="ir-brief-defs-block">
                        <h4 class="ir-subhead" id="ir-brief-defs-head">Definitions that matter for this client</h4>
                        <ul class="ir-defs-list" id="ir-brief-defs"></ul>
                    </div>
                </div>

                <div class="ir-subblock">
                    <h4 class="ir-subhead">APL product sheets the agent reads</h4>
                    <div class="ir-sheets" id="ir-sheets"></div>
                </div>
            </div>
        </div>

        <!-- Step 2 — compare / look up -->
        <div class="ir-step" data-step="2" id="ir-compare-step" hidden>
            <div class="ir-step-head">
                <span class="ir-step-num">2</span>
                <h3 id="ir-compare-title">Compare the insurers</h3>
            </div>
            <button id="ir-process-btn" type="button" disabled>Engage Insurance Research Agent</button>
            <div id="ir-process-status" class="ir-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="insurance-research">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>

            <!-- Advice cases: the insurers compared -->
            <div class="ir-results" id="ir-compare-results" hidden>
                <div class="ir-results-head">
                    <div>
                        <div class="ir-kicker">Insurers compared · definitions first, price second</div>
                        <div class="ir-results-title" id="ir-compare-headline"></div>
                    </div>
                    <span class="ir-mode-pill" id="ir-compare-mode"></span>
                </div>

                <div class="ir-rec" id="ir-rec">
                    <div class="ir-rec-label">Why — for Amelia's review</div>
                    <ul class="ir-list" id="ir-rec-reasons"></ul>
                </div>

                <div class="ir-table-wrap"><table class="ir-table" id="ir-compare-table"></table></div>
                <p class="muted ir-footnote">Year-1 premiums are insurer quotes at standard rates before underwriting. 10-year totals are illustrative.</p>

                <div class="ir-subblock">
                    <h4 class="ir-subhead">Year-1 premium by insurer — stepped vs level</h4>
                    <div class="ir-chart" id="ir-year1-chart"></div>
                </div>

                <details class="ir-details" id="ir-covers-details">
                    <summary>Cover breakdown by insurer</summary>
                    <div class="ir-table-wrap"><table class="ir-table" id="ir-covers-table"></table></div>
                </details>

                <div class="ir-two-col">
                    <div class="ir-subblock">
                        <h4 class="ir-subhead">Not chosen</h4>
                        <ul class="ir-list" id="ir-not-chosen"></ul>
                    </div>
                    <div class="ir-subblock">
                        <h4 class="ir-subhead">Notes</h4>
                        <ul class="ir-list" id="ir-observations"></ul>
                    </div>
                </div>

                <div class="ir-commission" id="ir-commission"></div>
                <div class="ir-approval required" id="ir-compare-approval">
                    <span class="ir-approval-pill">Human approval required</span>
                    <span id="ir-compare-approval-text"></span>
                </div>
            </div>

            <!-- Claim cases: the policy wording lookup -->
            <div class="ir-results" id="ir-wording-results" hidden>
                <div class="ir-results-head">
                    <div>
                        <div class="ir-kicker">Policy wording lookup · no comparison for a claim</div>
                        <div class="ir-results-title" id="ir-wording-title"></div>
                        <div class="ir-results-summary" id="ir-wording-pds"></div>
                    </div>
                    <span class="ir-mode-pill" id="ir-wording-mode"></span>
                </div>
                <div class="ir-subblock">
                    <h4 class="ir-subhead">Policy on file</h4>
                    <ul class="ir-list" id="ir-wording-policy"></ul>
                </div>
                <div class="ir-wording-items" id="ir-wording-items"></div>
                <div class="ir-handover" id="ir-handover">
                    <div>
                        <div class="ir-kicker">Handover to Claims</div>
                        <div id="ir-handover-text"></div>
                    </div>
                    <a class="ir-handover-btn" id="ir-handover-link" href="/agents/claims">Open the Claims Agent →</a>
                </div>
                <div class="ir-subblock">
                    <h4 class="ir-subhead">Next steps</h4>
                    <ul class="ir-list" id="ir-wording-next"></ul>
                </div>
                <div class="ir-approval required">
                    <span class="ir-approval-pill">Human approval required</span>
                    <span id="ir-wording-approval"></span>
                </div>
            </div>
        </div>

        <!-- Step 3 — definitions that matter -->
        <div class="ir-step" data-step="3" id="ir-defs-step" hidden>
            <div class="ir-step-head">
                <span class="ir-step-num">3</span>
                <h3 id="ir-defs-title">Definitions that matter for this client</h3>
            </div>
            <p class="muted">An insurer that misses a must-have ranks below every insurer that meets them, whatever its price. Hover a result for the PDS wording.</p>
            <div class="ir-legend">
                <span class="ir-res ir-res-meets">✓ Meets</span>
                <span class="ir-res ir-res-partly">◐ Partly</span>
                <span class="ir-res ir-res-gap">✗ Gap</span>
                <span class="ir-res ir-res-info">i See wording</span>
            </div>
            <div class="ir-table-wrap"><table class="ir-table ir-defs-table" id="ir-defs-table"></table></div>
        </div>

        <!-- Step 4 — stepped vs level -->
        <div class="ir-step" data-step="4" id="ir-svl-step" hidden>
            <div class="ir-step-head">
                <span class="ir-step-num">4</span>
                <h3>Stepped vs level over 10 years</h3>
            </div>
            <p class="muted">Stepped premiums start lower and rise with age; level premiums start higher and rise more slowly. Which suits the client is Amelia's call.</p>
            <div class="ir-svl-controls">
                <div class="ir-seg" id="ir-svl-insurers" role="group" aria-label="Insurer"></div>
                <div class="ir-seg" id="ir-svl-mode" role="group" aria-label="View">
                    <button type="button" class="ir-seg-btn active" data-mode="annual">Premium each year</button>
                    <button type="button" class="ir-seg-btn" data-mode="cumulative">Total paid</button>
                </div>
            </div>
            <div class="ir-chart" id="ir-svl-chart"></div>
            <div class="ir-svl-summary" id="ir-svl-summary"></div>
            <div class="ir-budget" id="ir-svl-budget" hidden></div>
            <details class="ir-details">
                <summary>Year-by-year table</summary>
                <div class="ir-table-wrap"><table class="ir-table" id="ir-svl-table"></table></div>
            </details>
            <p class="muted ir-footnote" id="ir-svl-label"></p>
        </div>

        <!-- Step 5 — workbook -->
        <div class="ir-step" data-step="5" id="ir-wb-step" hidden>
            <div class="ir-step-head">
                <span class="ir-step-num">5</span>
                <h3>Build the comparison workbook</h3>
            </div>
            <p class="muted">Four sheets for the file — Summary, Comparison (with a premium chart), Definitions and Projection (with a 10-year chart) — built with the same code as <code>research_generateComparisonWorkbook</code>.</p>
            <div class="ir-wb-row">
                <input type="text" id="ir-wb-notes" maxlength="500" placeholder="Optional research note for Amelia (printed on the Summary sheet)" aria-label="Research note for Amelia" />
                <button type="button" id="ir-wb-btn">Build workbook</button>
            </div>
            <div id="ir-wb-status" class="ir-status" hidden></div>
            <div class="ir-workbook" id="ir-wb-card" hidden>
                <span class="ir-workbook-icon" aria-hidden="true">📗</span>
                <div class="ir-workbook-meta">
                    <div class="ir-kicker">Comparison workbook (.xlsx)</div>
                    <div class="ir-workbook-name" id="ir-wb-name"></div>
                    <div class="ir-workbook-sheets" id="ir-wb-sheets"></div>
                </div>
                <a id="ir-wb-link" class="ir-workbook-btn" href="#" download>Download workbook</a>
            </div>
        </div>

        <!-- Step 6 — chat -->
        <div class="ir-step" data-step="6" id="ir-chat-step" hidden>
            <div class="ir-step-head">
                <span class="ir-step-num">6</span>
                <h3>Chat with Ivy's agent</h3>
            </div>
            <div class="ir-chat-layout">
                <div class="ir-chat-col">
                    <div class="ir-chips" id="ir-chat-suggestions"></div>
                    <div class="ir-chat-messages" id="ir-chat-messages" role="log" aria-live="polite">
                        <div class="ir-chat-empty">No follow-up messages yet. Ask a question below.</div>
                    </div>
                    <form class="ir-chat-form" id="ir-chat-form" autocomplete="off">
                        <input type="text" id="ir-chat-input"
                               placeholder="Ask a follow-up question (e.g. 'Why not Harbourline Life?')"
                               aria-label="Follow-up question to the Insurance Research Agent" />
                        <button type="submit" id="ir-chat-send" disabled>Send</button>
                    </form>
                    <div id="ir-chat-status" class="ir-status" hidden></div>
                </div>
                <aside class="ir-refs-col" aria-label="Web and document references">
                    <div class="ir-refs-head">
                        <h4>References</h4>
                        <span class="ir-refs-count" id="ir-refs-count">0</span>
                    </div>
                    <div class="ir-refs-list" id="ir-refs-list">
                        <div class="ir-refs-empty">References from the agent will appear here.</div>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</div>

<style>
    .ir-panel { --ir-accent: #f59e0b; --ir-teal: #14b8a6; }
    .ir-intro { margin: 0 0 0.2rem 0; color: #344054; font-size: 0.9rem; max-width: 70rem; }
    .ir-step code { background: rgba(245, 158, 11, 0.12); padding: 1px 6px; border-radius: 4px; font-size: 0.84rem; }

    .ir-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .ir-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .ir-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .ir-step-num {
        display: inline-grid; place-items: center; width: 1.55rem; height: 1.55rem; border-radius: 50%;
        background: color-mix(in srgb, #f59e0b 22%, #f6f7f9); border: 1px solid color-mix(in srgb, #f59e0b 55%, transparent);
        color: #845910; font-size: 0.78rem; font-weight: 700;
    }
    .ir-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.88rem; margin: 0.35rem 0 0.7rem 0; }
    .ir-step .muted a, .ir-empty a { color: #845910; }

    .ir-case-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .ir-case-row select {
        background: #fff; border: 1px solid rgba(16, 38, 72, 0.198); border-radius: 6px; color: #0b1f3a;
        padding: 0.5rem 0.7rem; font-size: 0.9rem; min-width: 340px; max-width: 100%;
    }
    .ir-case-row select:focus { outline: none; border-color: #f59e0b; box-shadow: 0 0 0 3px color-mix(in srgb, #f59e0b 25%, transparent); }
    .ir-secondary {
        background: transparent; color: #344054; border: 1px solid rgba(16, 38, 72, 0.198); border-radius: 6px;
        padding: 0.45rem 0.85rem; font-size: 0.85rem; cursor: pointer;
    }
    .ir-secondary:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }
    .ir-empty { margin-top: 0.6rem; }

    .ir-case { margin-top: 0.7rem; }
    .ir-case-card { background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.112); border-radius: 8px; padding: 0.8rem 0.95rem; }
    .ir-case-top { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.45rem; }
    .ir-case-num { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: #845910; font-weight: 700; font-size: 0.95rem; }
    .ir-pill {
        font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; border-radius: 999px;
        padding: 0.12rem 0.55rem; border: 1px solid rgba(20, 184, 166, 0.5); color: #0f766e; background: rgba(20, 184, 166, 0.1);
    }
    .ir-pill.claim { border-color: rgba(201, 161, 74, 0.6); color: #8a6a1f; background: rgba(201, 161, 74, 0.14); }
    .ir-pill-status { border-color: rgba(16, 38, 72, 0.22); color: #344054; background: #fff; text-transform: none; letter-spacing: 0; font-weight: 600; }
    .ir-case-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem 0.9rem; font-size: 0.86rem; color: #344054; }
    .ir-case-grid .span-2 { grid-column: span 2; }
    @@media (max-width: 820px) { .ir-case-grid { grid-template-columns: 1fr; } .ir-case-grid .span-2 { grid-column: span 1; } }
    .ir-case-grid .k, .ir-kicker {
        display: block; color: var(--cw-muted, #5d6b7e); font-weight: 600; text-transform: uppercase;
        font-size: 0.64rem; letter-spacing: 0.08em; margin-bottom: 0.1rem;
    }

    .ir-note {
        margin-top: 0.7rem; border-radius: 8px; padding: 0.6rem 0.8rem; font-size: 0.88rem;
        background: rgba(201, 161, 74, 0.12); border: 1px solid rgba(201, 161, 74, 0.45); color: #6b4f12;
    }
    .ir-note a { color: #6b4f12; font-weight: 700; }

    .ir-brief { margin-top: 0.8rem; border-left: 3px solid #f59e0b; padding-left: 0.85rem; }
    .ir-brief-title { color: #0b1f3a; font-weight: 700; font-size: 0.98rem; }
    .ir-brief-summary { color: #344054; font-size: 0.87rem; margin-top: 0.15rem; }
    .ir-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
    @@media (max-width: 900px) { .ir-two-col { grid-template-columns: 1fr; } }
    .ir-subblock { margin-top: 0.85rem; }
    .ir-subhead { margin: 0 0 0.35rem 0; font-size: 0.88rem; color: #1d2939; }
    .ir-list { margin: 0; padding-left: 1.1rem; font-size: 0.85rem; color: #344054; }
    .ir-list li { margin-bottom: 0.3rem; }
    .ir-budget { margin: 0.45rem 0 0 0; font-size: 0.85rem; color: #0f766e; font-weight: 600; }
    .ir-defs-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-size: 0.85rem; color: #344054; }
    .ir-defs-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.5rem; align-items: start; }
    .ir-prio {
        display: inline-block; text-align: center; font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
        border-radius: 999px; padding: 0.1rem 0.4rem; border: 1px solid rgba(16, 38, 72, 0.2); color: #475467; background: #fff;
    }
    .ir-prio.must { border-color: rgba(220, 38, 38, 0.45); color: #b42318; background: rgba(254, 226, 226, 0.6); }
    .ir-prio.important { border-color: rgba(245, 158, 11, 0.5); color: #954f12; background: rgba(254, 243, 199, 0.7); }
    .ir-prio.claim { border-color: rgba(201, 161, 74, 0.6); color: #8a6a1f; background: rgba(201, 161, 74, 0.12); }

    /* Product sheet thumbs + hover popovers */
    .ir-sheets { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .ir-sheet {
        position: relative; display: flex; flex-direction: column; gap: 0.15rem; width: 190px;
        background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.136); border-radius: 8px; padding: 0.5rem 0.6rem;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .ir-sheet.relevant { border-color: color-mix(in srgb, #f59e0b 55%, transparent); background: color-mix(in srgb, #f59e0b 6%, #f6f7f9); }
    .ir-sheet.dim { opacity: 0.6; }
    .ir-sheet:hover, .ir-sheet:focus-within { border-color: #f59e0b; box-shadow: 0 0 0 1px color-mix(in srgb, #f59e0b 35%, transparent); z-index: 10; opacity: 1; }
    .ir-sheet-name { font-weight: 700; color: #0b1f3a; font-size: 0.86rem; }
    .ir-sheet-prod { font-size: 0.72rem; color: #475467; }
    .ir-sheet-status { font-size: 0.72rem; font-weight: 700; color: #845910; }
    .ir-sheet-ext { position: absolute; top: 0.35rem; right: 0.5rem; font-size: 0.8rem; color: var(--cw-muted, #5d6b7e); text-decoration: none; }
    .ir-sheet-ext:hover { color: #845910; }
    .ir-sheet-pop {
        display: none; position: absolute; top: calc(100% + 6px); left: 0; min-width: 300px; max-width: 360px;
        background: #f2f4f7; border: 1px solid rgba(16, 38, 72, 0.186); border-radius: 8px; padding: 0.55rem 0.65rem;
        box-shadow: 0 8px 32px rgba(16, 24, 40, 0.12); z-index: 200; pointer-events: none;
    }
