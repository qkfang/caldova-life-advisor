@page "/agents/paraplanning"

<PageTitle>Paraplanning Agent — Advice Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #6366f1">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the agent console</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">🧮</div>
        <div>
            <div class="agent-header-dept">Paraplanning · Protection Advice</div>
            <h1>Paraplanning Agent</h1>
            <div class="agent-header-persona">Penny — Paraplanner</div>
            <p class="tagline">Works out what the family actually needs — then drafts the advice for Amelia.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #6366f1">
    <section class="panel pp-panel" style="--accent: #6366f1">
        <!-- Step 1 — pick a Client Case -->
        <div class="pp-step" data-step="1">
            <div class="pp-step-head">
                <span class="pp-step-num">1</span>
                <h3>Pick a Client Case</h3>
            </div>
            <div class="pp-picker">
                <label for="pp-case-select" class="pp-picker-label">Case number</label>
                <select id="pp-case-select" class="pp-select">
                    <option value="">— Loading cases —</option>
                </select>
                <button type="button" id="pp-refresh-btn" class="pp-refresh" title="Refresh the case list">↻</button>
            </div>
            <div id="pp-empty" class="pp-empty" hidden>
                No cases yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a> first.
            </div>
            <div class="pp-case-card" id="pp-case-card" hidden></div>
            <div class="pp-docs" id="pp-docs" hidden>
                <span class="pp-docs-label">Documents the agent applies</span>
                <div class="pp-docs-list" id="pp-docs-list"></div>
            </div>
            <div class="pp-note" id="pp-note" hidden>
                <div class="pp-note-title">Not a paraplanning case</div>
                <p id="pp-note-text"></p>
                <div class="pp-note-links" id="pp-note-links"></div>
            </div>
        </div>

        <!-- Step 2 — engage the agent -->
        <div class="pp-step" data-step="2" id="pp-process-step" hidden>
            <div class="pp-step-head">
                <span class="pp-step-num">2</span>
                <h3>Engage the Paraplanning Agent</h3>
            </div>
            <button id="pp-process-btn" type="button">Prepare the paraplanning with the Paraplanning Agent</button>
            <div id="pp-process-status" class="pp-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="paraplanning">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3 — needs analysis -->
        <div class="pp-step" data-step="3" id="pp-needs-step" hidden>
            <div class="pp-step-head">
                <span class="pp-step-num">3</span>
                <h3>Needs analysis — the working</h3>
            </div>
            <p class="muted">Every figure comes from the fact find on the Client Case; the working is shown line by line.</p>
            <div class="pp-needs" id="pp-needs"></div>
            <div class="pp-needs-total" id="pp-needs-total"></div>
        </div>

        <!-- Step 4 — strategy, ownership and rules checklist -->
        <div class="pp-step" data-step="4" id="pp-checklist-step" hidden>
            <div class="pp-step-head">
                <span class="pp-step-num">4</span>
                <h3>Strategy, ownership and rules checklist</h3>
            </div>
            <p class="muted">Each check cites a rule document and clause — select a clause to read the rule.</p>
            <div class="pp-checklist-card">
                <div class="pp-checklist-head">
                    <span class="pp-pill" id="pp-status-pill"></span>
                    <span class="pp-checklist-title">Advice checklist</span>
                    <span class="pp-source" id="pp-source"></span>
                </div>
                <p class="pp-status-reason" id="pp-status-reason"></p>
                <div class="pp-tally" id="pp-tally"></div>
                <div id="pp-checklist"></div>
            </div>

            <div class="pp-rules-head">
                <span class="pp-rules-title">Rule documents cited</span>
                <span class="pp-rules-count" id="pp-rules-count"></span>
            </div>
            <div class="pp-rules" id="pp-rules"></div>
        </div>

        <!-- Step 5 — draft SoA outline -->
        <div class="pp-step" data-step="5" id="pp-soa-step" hidden>
            <div class="pp-step-head">
                <span class="pp-step-num">5</span>
                <h3>Draft Statement of Advice — outline</h3>
            </div>
            <p class="muted" id="pp-soa-summary"></p>
            <div class="pp-soa" id="pp-soa"></div>

            <h4 class="pp-subhead">Premiums</h4>
            <div class="pp-table-wrap"><table class="pp-table" id="pp-premiums"></table></div>
            <p class="pp-premium-note" id="pp-premium-note"></p>

            <div class="pp-commission" id="pp-commission" hidden>
                <h4 class="pp-subhead">Commission — in dollars</h4>
                <div class="pp-commission-grid" id="pp-commission-grid"></div>
                <ul class="pp-commission-notes" id="pp-commission-notes"></ul>
            </div>
        </div>

        <!-- Step 6 — adviser sign-off -->
        <div class="pp-step" data-step="6" id="pp-signoff-step" hidden>
            <div class="pp-step-head">
                <span class="pp-step-num">6</span>
                <h3>Adviser sign-off</h3>
            </div>
            <div class="pp-signoff">
                <div class="pp-signoff-heading" id="pp-signoff-heading">Adviser sign-off required: Amelia</div>
                <div class="pp-signoff-status" id="pp-signoff-status"></div>
                <p class="pp-signoff-statement" id="pp-signoff-statement"></p>
                <div class="pp-signoff-grid">
                    <div>
                        <h5>Record</h5>
                        <ul id="pp-signoff-history"></ul>
                    </div>
                    <div>
                        <h5>Human approvals</h5>
                        <ul id="pp-signoff-approvals"></ul>
                    </div>
                </div>
                <div class="pp-signature">
                    <span class="pp-signature-line"></span>
                    <span class="pp-signature-name" id="pp-signature-name">Amelia, Senior Risk Adviser</span>
                </div>
                <p class="pp-plain" id="pp-plain"></p>
            </div>
            <p class="approval pp-approval-note">
                The agent drafts and checks; Penny reviews the paraplanning and Amelia gives the advice. Every SoA is signed by
                Amelia, replacing or cancelling cover is the client's decision with Amelia, and total cover of $2,000,000 or more
                gets Theo's second review first.
            </p>
        </div>
    </section>
</div>

<style>
    .pp-panel { --pp-accent: #6366f1; }
    .pp-panel a { color: #3b46c9; }

    .pp-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .pp-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .pp-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .pp-step-num {
        display: inline-grid; place-items: center;
        width: 1.55rem; height: 1.55rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--pp-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--pp-accent) 55%, transparent);
        color: color-mix(in srgb, var(--pp-accent) 60%, #0b1f3a);
        font-size: 0.78rem; font-weight: 700;
    }
    .pp-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }
    .pp-subhead { margin: 1rem 0 0.4rem 0; font-size: 0.88rem; color: #1d2939; }

    .pp-picker { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
    .pp-picker-label {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
    }
    .pp-select {
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.155);
        color: #0b1f3a;
        padding: 0.5rem 0.7rem;
        border-radius: 6px;
        font-size: 0.9rem;
        min-width: 340px;
        max-width: 100%;
        font-family: inherit;
    }
    .pp-select:focus {
        outline: none;
        border-color: var(--pp-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--pp-accent) 25%, transparent);
    }
    .pp-refresh {
        background: transparent; color: #344054;
        border: 1px solid rgba(16, 38, 72, 0.198);
        border-radius: 6px; padding: 0.35rem 0.6rem;
        font-size: 0.95rem; cursor: pointer;
    }
    .pp-refresh:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .pp-empty {
        margin-top: 0.7rem; padding: 0.7rem 0.9rem;
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 8px; color: #954f12; font-size: 0.88rem;
    }

    .pp-case-card {
        margin-top: 0.75rem;
        display: grid; grid-template-columns: 1fr 1fr;
        gap: 0.45rem 1.2rem;
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        font-size: 0.88rem; color: #344054;
    }
    @@media (max-width: 820px) { .pp-case-card { grid-template-columns: 1fr; } }
    .pp-case-card .row { display: flex; gap: 0.5rem; }
    .pp-case-card .row.span-2 { grid-column: 1 / -1; }
    .pp-case-card .k {
        min-width: 120px; color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.08em;
        font-weight: 700; padding-top: 0.15rem;
    }
    .pp-case-card .v { color: #1d2939; }
    .pp-case-card .v.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .pp-case-card .prio-pill {
        display: inline-block; padding: 0.05rem 0.55rem; border-radius: 999px;
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-right: 0.35rem;
    }
    .pp-case-card .prio-pill.urgent   { background: rgba(239, 68, 68, 0.18); color: #c11818; border: 1px solid rgba(239, 68, 68, 0.4); }
    .pp-case-card .prio-pill.high     { background: rgba(245, 158, 11, 0.18); color: #954f12; border: 1px solid rgba(245, 158, 11, 0.4); }
    .pp-case-card .prio-pill.standard { background: rgba(34, 197, 94, 0.16); color: #0f7032; border: 1px solid rgba(34, 197, 94, 0.4); }

    .pp-docs { margin-top: 0.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
    .pp-docs-label {
        font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700; margin-right: 0.3rem;
    }
    .pp-docs-list { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .pp-doc-chip {
        font-size: 0.76rem; padding: 0.15rem 0.6rem; border-radius: 999px;
        background: rgba(99, 102, 241, 0.1); color: #3540b8;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .pp-note {
        margin-top: 0.8rem; padding: 0.8rem 1rem;
        border-radius: 10px;
        background: rgba(201, 161, 74, 0.1);
        border: 1px solid rgba(201, 161, 74, 0.45);
        color: #5c4512; font-size: 0.9rem;
    }
    .pp-note-title { font-weight: 700; color: #3f2f08; margin-bottom: 0.25rem; }
    .pp-note p { margin: 0 0 0.55rem 0; line-height: 1.55; }
    .pp-note-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pp-note-links a {
        display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px;
        background: #fff; border: 1px solid rgba(201, 161, 74, 0.6);
        color: #5c4512 !important; font-weight: 600; font-size: 0.82rem; text-decoration: none;
    }
    .pp-note-links a:hover { background: rgba(201, 161, 74, 0.15); }

    #pp-process-btn {
        background: var(--cw-primary); color: #fff;
        border: none; border-radius: 999px;
        padding: 0.5rem 1rem; font-size: 0.88rem; font-weight: 700;
        cursor: pointer; margin-top: 0.35rem;
    }
    #pp-process-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .pp-status { margin-top: 0.6rem; font-size: 0.88rem; color: #344054; }
    .pp-status.error { color: #c11818; }
    .pp-status.warn { color: #954f12; }
    .pp-status .spinner {
        display: inline-block; width: 12px; height: 12px;
        border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle;
        animation: pp-spin 0.7s linear infinite;
    }
    @@keyframes pp-spin { to { transform: rotate(360deg); } }
    .pp-panel .engage-narrative-body { contain: inline-size; overflow-x: auto; }

    /* Needs analysis */
    .pp-needs { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0.7rem; }
    .pp-need {
        background: #fff;
        border: 1px solid rgba(16, 38, 72, 0.12);
        border-top: 3px solid var(--pp-accent);
        border-radius: 10px;
        padding: 0.75rem 0.9rem 0.8rem;
        font-size: 0.86rem;
    }
    .pp-need-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-bottom: 0.4rem; }
    .pp-need-title { font-weight: 700; color: #0b1f3a; }
    .pp-need-who { font-size: 0.74rem; color: var(--cw-muted, #5d6b7e); }
    .pp-need table { width: 100%; border-collapse: collapse; }
    .pp-need td { padding: 0.22rem 0; vertical-align: top; color: #344054; }
    .pp-need td.amt { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; padding-left: 0.6rem; }
    .pp-need tr.less td { color: #9a3412; }
    .pp-need tr.total td { border-top: 1px solid rgba(16, 38, 72, 0.18); font-weight: 600; color: #1d2939; }
    .pp-need tr.result td { border-top: 1px solid rgba(16, 38, 72, 0.18); font-weight: 700; color: #0b1f3a; }
    .pp-need tr.note td { font-size: 0.76rem; font-style: italic; color: var(--cw-muted, #5d6b7e); }
    .pp-need-rec {
        margin-top: 0.55rem; padding: 0.45rem 0.6rem; border-radius: 8px;
        background: color-mix(in srgb, var(--pp-accent) 9%, #fff);
        border: 1px solid color-mix(in srgb, var(--pp-accent) 35%, transparent);
    }
    .pp-need-rec .k { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.1em; color: #3540b8; font-weight: 700; }
    .pp-need-rec .v { font-weight: 700; color: #0b1f3a; font-size: 0.95rem; }
    .pp-need-rec .b { font-size: 0.78rem; color: #475467; margin-top: 0.15rem; }
    .pp-needs-total {
        margin-top: 0.75rem; padding: 0.6rem 0.85rem; border-radius: 8px;
        background: #0b1f3a; color: #fff; font-size: 0.88rem; font-weight: 600;
    }

    /* Checklist */
    .pp-checklist-card {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 10px;
        padding: 0.95rem 1rem 1rem;
        font-size: 0.88rem; color: #1d2939;
    }
    .pp-checklist-head { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
    .pp-checklist-title { color: #0b1f3a; font-weight: 700; font-size: 0.92rem; }
    .pp-pill {
        padding: 0.22rem 0.8rem; border-radius: 999px;
        font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        background: rgba(165, 180, 252, 0.18); color: #2c51e5; border: 1px solid rgba(16, 38, 72, 0.24);
    }
    .pp-pill.ready { background: rgba(34, 197, 94, 0.16); color: #0f7032; border-color: rgba(34, 197, 94, 0.4); }
    .pp-pill.more  { background: rgba(245, 158, 11, 0.18); color: #954f12; border-color: rgba(245, 158, 11, 0.4); }
    .pp-pill.na    { background: rgba(110, 193, 255, 0.14); color: #1564a8; border-color: rgba(110, 193, 255, 0.35); }
    .pp-source {
        margin-left: auto; font-size: 0.7rem; color: var(--cw-muted, #5d6b7e);
        border: 1px dashed rgba(16, 38, 72, 0.217); border-radius: 999px; padding: 0.05rem 0.55rem;
    }
    .pp-status-reason { margin: 0.1rem 0 0.5rem 0; font-size: 0.86rem; line-height: 1.5; }
    .pp-tally { font-size: 0.8rem; color: #344054; margin: 0 0 0.5rem 0; }
    .pp-tally .pass { color: #0f7032; font-weight: 700; }
    .pp-tally .fail { color: #c11818; font-weight: 700; }
    .pp-tally .info { color: #954f12; font-weight: 700; }
    .pp-cat {
        margin: 0.75rem 0 0.35rem 0;
        font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: #3540b8; font-weight: 700;
    }
    .pp-items { list-style: none; margin: 0; padding: 0; }
    .pp-items li {
        display: grid; grid-template-columns: auto 1fr; gap: 0.6rem;
        padding: 0.55rem 0.6rem; margin-bottom: 0.4rem; border-radius: 8px;
        background: #fff; border: 1px solid rgba(16, 38, 72, 0.087);
    }
    .pp-items li.pass { border-left: 3px solid #34d399; }
    .pp-items li.fail { border-left: 3px solid #f87171; background: rgba(239, 68, 68, 0.05); }
    .pp-items li.info { border-left: 3px solid #fcd34d; }
    .pp-items .icon {
        display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
        font-size: 0.75rem; font-weight: 700; margin-top: 0.1rem;
    }
    .pp-items .icon.pass { background: rgba(34, 197, 94, 0.2); color: #0f7032; border: 1px solid rgba(34, 197, 94, 0.5); }
    .pp-items .icon.fail { background: rgba(239, 68, 68, 0.2); color: #c11818; border: 1px solid rgba(239, 68, 68, 0.5); }
    .pp-items .icon.info { background: rgba(245, 158, 11, 0.2); color: #954f12; border: 1px solid rgba(245, 158, 11, 0.5); }
    .pp-items .label { color: #0b1f3a; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
    .pp-items .status-text { font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cw-muted, #5d6b7e); }
    .pp-items .finding { color: #344054; font-size: 0.84rem; line-height: 1.5; margin-top: 0.2rem; }
    .clause-ref {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.7rem; color: #2c51e5;
        background: rgba(99, 102, 241, 0.14); border: 1px solid rgba(99, 102, 241, 0.35);
        padding: 0.05rem 0.4rem; border-radius: 4px; cursor: pointer;
    }
    .clause-ref:hover { background: rgba(99, 102, 241, 0.3); color: #0b1f3a; }
    .clause-doc { font-size: 0.72rem; color: var(--cw-muted, #5d6b7e); font-style: italic; }

    /* Rule documents */
    .pp-rules-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; margin: 1rem 0 0.5rem; }
    .pp-rules-title { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--cw-muted, #5d6b7e); font-weight: 700; }
    .pp-rules-count { font-size: 0.8rem; color: var(--cw-muted, #5d6b7e); }
    .pp-rules { display: grid; gap: 0.5rem; }
    .rule-doc { background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.136); border-radius: 10px; overflow: hidden; }
