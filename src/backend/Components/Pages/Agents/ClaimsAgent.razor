    .claims-teams { background: color-mix(in srgb, #5b5fc7 10%, #f6f7f9); border-color: rgba(129, 133, 230, 0.4); }
    .claims-lodged { background: rgba(34, 197, 94, 0.07); border-color: rgba(34, 197, 94, 0.35); }
    .claims-referred { background: rgba(239, 68, 68, 0.07); border-color: rgba(239, 68, 68, 0.35); }
    .claims-hold { background: rgba(245, 158, 11, 0.08); border-color: rgba(245, 158, 11, 0.35); }
    .claims-outcome-summary { font-weight: 700; color: #0b1f3a !important; }
    .claims-protected {
        margin-top: 0.6rem; padding: 0.65rem 0.85rem; border-radius: 8px;
