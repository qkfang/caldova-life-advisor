    .claims-benefit-table tr.kind-total td.amount { color: #0f7032; }
    .claims-net {
        margin-top: 0.6rem; display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap;
        padding: 0.55rem 0.85rem; border-radius: 8px;
