@page "/agents/claims"

<PageTitle>Claims Agent — Advice Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #a855f7">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to Guru House</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">🤝</div>
        <div>
            <div class="agent-header-dept">Claims · Claims &amp; Care</div>
            <h1>Claims Agent</h1>
            <div class="agent-header-persona">Ben — Benefit Claims Advocate</div>
            <p class="tagline">Makes the claim as easy as it can be — and lodges it only after a person approves.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #a855f7">
    <section class="panel claims-panel" style="--accent: #a855f7">
        <div id="claims-deeplink" class="claims-deeplink" hidden></div>

        <!-- Step 1 — pick a case -->
        <div class="claims-step" data-step="1">
            <div class="claims-step-head">
                <span class="claims-step-num">1</span>
                <h3>Pick a Client Case</h3>
            </div>
            <div class="claims-case-picker">
                <select id="claims-case-select" class="claims-select" aria-label="Client Case">
                    <option value="">— Loading cases —</option>
                </select>
                <button id="claims-refresh-btn" type="button" class="claims-refresh" title="Reload cases">↻</button>
            </div>
            <div id="claims-case-empty" class="claims-status" hidden>
                No cases in memory yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a> first.
            </div>
            <div id="claims-case-summary" class="claims-summary" hidden>
                <div class="claims-summary-grid">
                    <div><span class="k">Case</span><span id="claims-case-num"></span></div>
                    <div><span class="k">Client</span><span id="claims-case-client"></span></div>
                    <div><span class="k">Cover</span><span id="claims-case-cover"></span></div>
                    <div><span class="k">Request</span><span id="claims-case-type"></span></div>
                    <div><span class="k">Received</span><span id="claims-case-received"></span></div>
                    <div><span class="k">Adviser</span><span id="claims-case-adviser"></span></div>
                    <div><span class="k">Amount</span><span id="claims-case-amount"></span></div>
                    <div><span class="k">Priority</span><span id="claims-case-priority"></span></div>
                    <div class="span-2"><span class="k">Summary</span><span id="claims-case-summary-text"></span></div>
                </div>
            </div>
            <div id="claims-not-a-claim" class="claims-note-box" hidden>
                <div class="claims-note-title">Nothing to claim on this case</div>
                <p id="claims-not-a-claim-text"></p>
                <div class="claims-links" id="claims-not-a-claim-links"></div>
            </div>
        </div>

        <!-- Step 2 — claim details -->
        <div class="claims-step" data-step="2" id="claims-inputs-step" hidden>
            <div class="claims-step-head">
                <span class="claims-step-num">2</span>
                <h3>Confirm the claim details</h3>
            </div>
            <p class="muted">Defaults come from the Client Case and the policy schedule — edit any value to see how the checks change.</p>
            <div id="claims-inputs-hint" class="claims-hint" hidden></div>

            <div class="claims-policy-card" id="claims-policy-card">
                <div class="claims-card-label">Policy schedule</div>
                <dl class="claims-facts" id="claims-policy-facts"></dl>
            </div>

            <form id="claims-inputs-form" class="claims-form" autocomplete="off">
                <fieldset>
                    <legend>Claim</legend>
                    <div class="claims-grid">
                        <label>Claim type<select name="claimType"></select></label>
                        <label><span id="claims-event-label">Date of the event</span> (dd/mm/yyyy)<input type="text" name="eventDate" placeholder="dd/mm/yyyy" /></label>
                        <label class="span-2" data-field="lump"><span id="claims-sum-label">Sum insured (AUD)</span><input type="number" name="sumInsured" min="0" step="1" /></label>
                        <label data-field="death">Beneficiary's share (%)<input type="number" name="beneficiarySharePercent" min="0" max="100" step="0.01" /></label>
                    </div>
                    <div class="claims-event" id="claims-event-text"></div>
                </fieldset>
                <fieldset data-field="income">
                    <legend>Income protection — benefit inputs</legend>
                    <div class="claims-grid">
                        <label>Insured monthly benefit (AUD)<input type="number" name="insuredMonthly" min="0" step="1" /></label>
                        <label>Waiting period (days)<input type="number" name="waitingPeriodDays" min="0" max="730" step="1" /></label>
                        <label class="span-2"><span id="claims-earnings-label">Earnings in the 12 months before the disability (AUD)</span><input type="number" name="annualEarnings" min="0" step="1" /></label>
                    </div>
                    <div class="claims-event" id="claims-earnings-text"></div>
                </fieldset>
                <fieldset>
                    <legend>Claimant</legend>
                    <div class="claims-grid">
                        <label>Claimant's name<input type="text" name="claimantName" /></label>
                        <label>Relationship to the policy<select name="claimantRelationship"></select></label>
                    </div>
                    <div class="claims-onfile" id="claims-claimant-onfile"></div>
                </fieldset>
                <fieldset>
                    <legend>Bank account for the benefit — masked</legend>
                    <div class="claims-grid claims-grid-3">
                        <label>Name on the account<input type="text" name="accountName" /></label>
                        <label>BSB<input type="text" name="bsb" /></label>
                        <label>Account<input type="text" name="account" /></label>
                    </div>
                    <div class="claims-onfile" id="claims-account-onfile"></div>
                </fieldset>
            </form>
        </div>

        <!-- Step 3 — engage the agent -->
        <div class="claims-step" data-step="3" id="claims-process-step" hidden>
            <div class="claims-step-head">
                <span class="claims-step-num">3</span>
                <h3>Engage the Claims Agent</h3>
            </div>
            <button id="claims-process-btn" type="button">Process with Claims Agent</button>
            <div id="claims-process-status" class="claims-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="claims">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations and every output item, including the claims_* MCP tool calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>

            <div id="claims-result" class="claims-result" hidden>
                <div class="claims-two-col">
                    <div class="claims-card">
                        <div class="claims-card-label">Claimant checks</div>
                        <ul id="claims-claimant-checks" class="claims-checks-list"></ul>
                    </div>
                    <div class="claims-card">
                        <div class="claims-card-label">Policy checks</div>
                        <ul id="claims-policy-checks" class="claims-checks-list"></ul>
                    </div>
                </div>

                <div class="claims-card">
                    <div class="claims-card-label">Claim pack</div>
                    <div class="claims-table-scroll">
                        <table class="claims-pack-table">
                            <thead><tr><th>Document</th><th>Status</th><th>Note</th></tr></thead>
                            <tbody id="claims-pack-body"></tbody>
                        </table>
                    </div>
                </div>

                <div class="claims-card claims-benefit">
                    <div class="claims-card-label" id="claims-benefit-title">Expected benefit</div>
                    <div class="claims-table-scroll">
                        <table class="claims-benefit-table">
                            <tbody id="claims-benefit-body"></tbody>
                        </table>
                    </div>
                    <div class="claims-net" id="claims-benefit-result">
                        <span class="k" id="claims-benefit-result-label">Expected benefit</span>
                        <span id="claims-benefit-result-value"></span>
                    </div>
                    <ul class="claims-benefit-notes" id="claims-benefit-notes"></ul>
                    <div class="claims-rule" id="claims-benefit-rule"></div>
                </div>

                <div class="claims-two-col">
                    <div class="claims-card" id="claims-timeframes-card">
                        <div class="claims-card-label">Insurer timeframes — Life Insurance Code of Practice</div>
                        <dl class="claims-facts claims-facts-stack" id="claims-timeframes"></dl>
                    </div>
                    <div class="claims-card" id="claims-notes-card">
                        <div class="claims-card-label">Notes</div>
                        <div id="claims-notes" class="claims-notes"></div>
                    </div>
                </div>

                <div class="claims-card" id="claims-activity-card" hidden>
                    <div class="claims-card-label">What happened — activity on the client's file</div>
                    <ol id="claims-activity" class="claims-timeline"></ol>
                </div>

                <div class="claims-callout claims-approval" id="claims-approval">
                    <div class="claims-callout-head">
                        <span class="claims-step-num small">!</span>
                        <span class="claims-callout-title">Human approval</span>
                        <span class="claims-pill" id="claims-approval-pill"></span>
                    </div>
                    <ul id="claims-approval-reasons" class="claims-reasons"></ul>
                    <p class="claims-recommendation" id="claims-recommendation"></p>
                    <p class="claims-approver" id="claims-approval-approver"></p>
                </div>

                <!-- Microsoft Teams approval (lodgement or block), then lodgement -->
                <div class="claims-callout claims-teams" id="claims-teams" hidden>
                    <div class="claims-callout-head">
                        <span class="claims-step-num small teams">T</span>
                        <span class="claims-callout-title" id="claims-teams-title">Microsoft Teams approval</span>
                        <span class="claims-pill" id="claims-teams-pill"></span>
                    </div>
                    <p class="claims-teams-msg" id="claims-teams-msg"></p>
                    <div class="claims-teams-preview" id="claims-teams-preview"></div>
                    <div class="claims-teams-meta">
                        <div><span class="k">Approval id</span> <code id="claims-teams-approvalid"></code></div>
                        <div><span class="k">Approval link</span> <a id="claims-teams-link" href="#" target="_blank" rel="noopener">open</a></div>
                    </div>
                    <div class="claims-actions">
                        <button type="button" id="claims-popup-btn" class="claims-popup">Open approval popup</button>
                        <button type="button" id="claims-lodge-btn" class="claims-lodge" disabled>Lodge claim</button>
                    </div>
                    <div class="claims-lodge-hint" id="claims-lodge-hint">Lodging unlocks once the approval is recorded.</div>
                    <div class="claims-teams-status" id="claims-teams-status" hidden></div>
                </div>

                <!-- Lodged: reference and what happened next -->
                <div class="claims-callout claims-lodged" id="claims-lodged" hidden>
                    <div class="claims-callout-head">
                        <span class="claims-step-num small lodged">✓</span>
                        <span class="claims-callout-title" id="claims-lodged-title">Claim lodged</span>
                        <span class="claims-pill" id="claims-outcome-pill" hidden></span>
                    </div>
                    <p id="claims-lodged-text"></p>
                    <ol class="claims-timeline" id="claims-outcome-timeline"></ol>
                    <p class="claims-outcome-summary" id="claims-outcome-summary" hidden></p>
                </div>

                <!-- Referred: no lodgement; the block is the Team Leader's decision -->
                <div class="claims-callout claims-referred" id="claims-referred" hidden>
                    <div class="claims-callout-head">
                        <span class="claims-step-num small blocked">✕</span>
                        <span class="claims-callout-title" id="claims-referred-title">Not lodged — referred to Financial Crime</span>
                        <span class="claims-pill status-pending" id="claims-referred-pill">Awaiting Theo</span>
                    </div>
                    <p id="claims-referred-text"></p>
                    <div class="claims-protected" id="claims-protected" hidden>
                        <div class="claims-protected-amount" id="claims-protected-amount"></div>
                        <div class="claims-protected-note" id="claims-protected-note"></div>
                    </div>
                    <div class="claims-actions">
                        <button type="button" id="claims-referred-lodge" class="claims-lodge" disabled>Lodge claim</button>
                    </div>
                    <div class="claims-lodge-hint" id="claims-referred-hint"></div>
                </div>

                <!-- Hold: not ready to lodge -->
                <div class="claims-callout claims-hold" id="claims-hold" hidden>
                    <div class="claims-callout-head">
                        <span class="claims-step-num small hold">…</span>
                        <span class="claims-callout-title">Not ready to lodge</span>
                        <span class="claims-pill optional">No approval raised</span>
                    </div>
                    <p id="claims-hold-text"></p>
                    <div class="claims-actions">
                        <button type="button" class="claims-lodge" disabled>Lodge claim</button>
                    </div>
                </div>

                <div class="claims-card claims-update-card">
                    <div class="claims-card-label" id="claims-update-title">Claim update draft (for Cara)</div>
                    <div id="claims-update" class="agent-md"></div>
                </div>
            </div>
        </div>

    </section>
</div>

<!-- Approval popup: the in-page stand-in for the Approve / Reject actions
     on the Microsoft Teams card. Approving a lodgement resumes the same
     Claims Agent conversation so it can call claims_lodgeClaim. -->
<div id="claims-approval-modal" class="claims-modal" hidden role="dialog" aria-modal="true" aria-labelledby="claims-modal-title">
    <div class="claims-modal-backdrop" data-modal-dismiss></div>
    <div class="claims-modal-card" role="document">
        <button type="button" class="claims-modal-close" data-modal-dismiss aria-label="Close">×</button>
        <div class="claims-modal-header">
            <span class="claims-modal-badge">!</span>
            <div>
                <h3 id="claims-modal-title">Claim lodgement approval</h3>
                <div class="claims-modal-sub" id="claims-modal-sub">Life Advice Guru — Claim lodgement approval · Microsoft Teams</div>
            </div>
        </div>
        <div class="claims-modal-deeplink" id="claims-modal-deeplink" hidden></div>
        <div class="claims-modal-why">Why approval is needed</div>
        <ul class="claims-modal-reasons" id="claims-modal-reasons"></ul>
        <div class="claims-modal-meta">
            <div><span class="k">Case</span><span id="claims-modal-case"></span></div>
            <div><span class="k">Approval id</span><code id="claims-modal-approval-id"></code></div>
            <div class="span-2"><span class="k">Client</span><span id="claims-modal-client"></span></div>
            <div class="span-2"><span class="k">Policy</span><span id="claims-modal-policy"></span></div>
            <div class="span-2"><span class="k">Claim</span><span id="claims-modal-type"></span></div>
            <div class="span-2"><span class="k">Payee</span><span id="claims-modal-payee"></span></div>
            <div class="span-2 amount-row"><span class="k" id="claims-modal-benefit-label">Expected benefit</span><strong id="claims-modal-benefit"></strong></div>
        </div>
        <div class="claims-modal-why">Recommendation</div>
        <p class="claims-modal-recommendation" id="claims-modal-recommendation"></p>
        <p class="claims-modal-explainer" id="claims-modal-explainer">
            Stands in for <strong>Approve</strong> on the Teams card. Lodging stays locked until the approval is recorded.
        </p>
        <div class="claims-modal-status" id="claims-modal-status" hidden></div>
        <div class="claims-modal-agent" id="claims-modal-agent" hidden>
            <div class="claims-modal-agent-label">Agent reply after approval</div>
            <div class="agent-md" id="claims-modal-agent-body"></div>
        </div>
        <div class="claims-modal-actions">
            <button type="button" id="claims-modal-reject-btn" class="claims-modal-reject">Reject</button>
            <button type="button" id="claims-modal-cancel-btn" class="claims-modal-cancel" data-modal-dismiss>Close</button>
            <button type="button" id="claims-modal-approve-btn" class="claims-modal-approve">Approve</button>
            <button type="button" id="claims-modal-lodge-btn" class="claims-modal-lodge" disabled>Lodge claim</button>
        </div>
    </div>
</div>

<style>
    .claims-panel, .claims-modal { --clm-accent: #a855f7; --clm-teams: #5b5fc7; }
    .claims-panel [hidden], .claims-modal[hidden], .claims-modal [hidden] { display: none !important; }

    /* ── Steps ────────────────────────────────────────────────── */
    .claims-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .claims-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .claims-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .claims-step-num {
        display: inline-grid; place-items: center; flex: 0 0 auto;
        width: 1.55rem; height: 1.55rem; border-radius: 50%;
        background: color-mix(in srgb, var(--clm-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--clm-accent) 55%, transparent);
        color: color-mix(in srgb, var(--clm-accent) 60%, #0b1f3a); font-size: 0.78rem; font-weight: 700;
    }
    .claims-step-num.small { width: 1.4rem; height: 1.4rem; font-size: 0.7rem; }
    .claims-step-num.teams { background: rgba(91, 95, 199, 0.3); border-color: rgba(129, 133, 230, 0.7); color: #2c51e5; }
    .claims-step-num.blocked { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.6); color: #c11818; }
    .claims-step-num.lodged { background: rgba(34, 197, 94, 0.2); border-color: rgba(34, 197, 94, 0.6); color: #0f7032; }
    .claims-step-num.hold { background: rgba(245, 158, 11, 0.2); border-color: rgba(245, 158, 11, 0.6); color: #954f12; }
    .claims-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }

    .claims-deeplink {
        margin: 0.3rem 0 0.4rem 0; padding: 0.6rem 0.85rem; border-radius: 10px; font-size: 0.88rem;
        background: rgba(91, 95, 199, 0.16); border: 1px solid rgba(129, 133, 230, 0.45); color: #1d2939;
    }
    .claims-deeplink.error { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.4); color: #c11818; }

    .claims-case-picker { display: flex; gap: 0.5rem; align-items: center; }
    .claims-select, .claims-form select, .claims-form input {
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 6px; color: #0b1f3a; font-size: 0.9rem;
        padding: 0.5rem 0.65rem; font-family: inherit;
    }
    .claims-select { flex: 1; min-width: 0; }
    .claims-select:focus, .claims-form select:focus, .claims-form input:focus {
        outline: none; border-color: var(--clm-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--clm-accent) 25%, transparent);
    }
    .claims-refresh {
        background: transparent; color: #344054;
        border: 1px solid rgba(16, 38, 72, 0.198); border-radius: 6px;
        padding: 0.45rem 0.7rem; font-size: 0.95rem; cursor: pointer;
    }
    .claims-refresh:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .claims-summary {
        margin-top: 0.7rem; background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112); border-radius: 8px; padding: 0.7rem 0.85rem;
    }
    .claims-summary-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.85rem;
        font-size: 0.85rem; color: #344054;
    }
    .claims-summary-grid .span-2 { grid-column: span 2; }
    .claims-summary-grid .k {
        display: inline-block; min-width: 76px; color: var(--cw-muted, #5d6b7e); font-weight: 600;
        text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.08em; margin-right: 0.5rem;
    }

    .claims-note-box {
        margin-top: 0.7rem; padding: 0.75rem 0.9rem; border-radius: 10px;
        background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.32); color: #12405e;
    }
    .claims-note-title { font-weight: 700; font-size: 0.92rem; color: #0b1f3a; }
    .claims-note-box p { margin: 0.3rem 0 0.5rem 0; font-size: 0.88rem; line-height: 1.5; }
    .claims-links { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .claims-links a {
        display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.82rem; font-weight: 600;
        background: #ffffff; border: 1px solid rgba(14, 165, 233, 0.45); color: #126891; text-decoration: none;
    }
    .claims-links a:hover { background: rgba(14, 165, 233, 0.12); }

    /* ── Inputs ───────────────────────────────────────────────── */
    .claims-hint {
        margin: 0 0 0.7rem 0; padding: 0.55rem 0.8rem; border-radius: 8px; font-size: 0.86rem; line-height: 1.45;
        background: color-mix(in srgb, var(--clm-accent) 10%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--clm-accent) 30%, transparent); color: #1d2939;
    }
    .claims-policy-card {
        background: #ffffff; border: 1px solid rgba(16, 38, 72, 0.112); border-radius: 10px;
        padding: 0.7rem 0.9rem; margin-bottom: 0.75rem;
    }
    .claims-facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; margin: 0; font-size: 0.85rem; }
    .claims-facts dt { color: var(--cw-muted, #5d6b7e); font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.07em; padding-top: 0.12rem; }
    .claims-facts dd { margin: 0; color: #1d2939; line-height: 1.45; min-width: 0; overflow-wrap: anywhere; }
    .claims-facts-stack { grid-template-columns: 1fr; gap: 0.15rem; }
