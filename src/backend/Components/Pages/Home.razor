@page "/"
@using System.Text.RegularExpressions

<PageTitle>Advice Team in a Day — Caldova Life Advice</PageTitle>

<section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-copy">
        <div class="hero-eyebrow">Caldova Life Advice · Agent console</div>
        <h1 id="home-hero-title">Advice Team <span class="hl">in a Day</span></h1>
        <p class="hero-lead">
            Eight specialist AI agents support Caldova's practice team, from the first conversation to the
            claim. They gather facts, check, calculate, compare and draft — Amelia gives the advice, and
            people approve every decision that matters.
        </p>
        <div class="hero-actions">
            <a class="hero-btn hero-btn-solid" href="agents/onboarding">Start at the front desk <span aria-hidden="true">→</span></a>
            <a class="hero-btn hero-btn-outline" href="@($"scenarios/{ScenarioCatalog.All[0].Id}")">Run a scenario</a>
        </div>
    </div>

    <aside class="hero-board" aria-label="Client scenarios">
        <div class="hero-board-head">
            <span class="live-dot" aria-hidden="true"></span>
            <span>Client Cases</span>
            <span class="hero-board-count">@ScenarioCatalog.All.Count scenarios</span>
        </div>
        <ul class="hero-board-list">
            @foreach (var scenario in ScenarioCatalog.All)
            {
                <li>
                    <a href="@($"scenarios/{scenario.Id}")">
                        <span class="hb-icon" aria-hidden="true">@scenario.Icon</span>
                        <span class="hb-body">
                            <span class="hb-name">@scenario.Customer</span>
                            <span class="hb-meta">@scenario.ShortTitle · @scenario.CaseNumber</span>
                        </span>
                        <span class="hb-status @StatusClass(scenario.Outcome)">@CleanOutcome(scenario.Outcome)</span>
                    </a>
                </li>
            }
        </ul>
    </aside>
</section>

<section class="home-section" aria-labelledby="lifecycle-title">
    <div class="section-head">
        <h2 id="lifecycle-title">One process for both sides</h2>
        <p>Every request follows the same lifecycle. Each stage is supported by the agents below it.</p>
    </div>
    <ol class="lifecycle-strip">
        @foreach (var (stage, index) in AgentCatalog.Lifecycle.Select((s, i) => (s, i + 1)))
        {
            <li class="lifecycle-stage">
                <div class="lifecycle-stage-head">
                    <span class="lifecycle-num">@index</span>
                    <span class="lifecycle-name">@stage</span>
                </div>
                <p class="lifecycle-desc">@StageDescription(stage)</p>
                <div class="lifecycle-agents">
                    @foreach (var agent in AgentCatalog.All.Where(a => a.Id != "team-leader" && a.Stages.Contains(stage)))
                    {
                        <a class="lifecycle-agent" href="@($"agents/{agent.Id}")" style="--accent: @agent.Accent">
                            <span aria-hidden="true">@agent.Icon</span> @agent.Department
                        </a>
                    }
                </div>
            </li>
        }
    </ol>
    @if (AgentCatalog.FindById("team-leader") is { } leader)
    {
        <a class="lifecycle-oversight" href="agents/team-leader" style="--accent: @leader.Accent">
            <span aria-hidden="true">@leader.Icon</span>
            <span><strong>@leader.Department</strong> — every stage: service levels, claim and complaint (IDR) clocks, approvals and file quality.</span>
        </a>
    }
</section>

<section class="home-section" aria-labelledby="sides-title">
    <div class="section-head">
        <h2 id="sides-title">Two sides of the practice</h2>
        <p>Two small teams with one team leader between them, and one group of agents that supports both.</p>
    </div>
    <div class="sides-grid">
        @foreach (var side in Sides)
        {
            <div class="side-card" style="--side: @PracticeSides.ColourFor(side.Name)">
                <div class="side-card-head">
                    <span class="side-swatch" aria-hidden="true"></span>
                    <h3>@side.Name</h3>
                </div>
                <p class="side-covers">@side.Covers</p>
                <div class="side-team"><span class="k">Team</span>@side.Team</div>
                <div class="side-agents-label">@side.AgentsLabel</div>
                <div class="side-agents">
                    @foreach (var agent in AgentCatalog.OnSide(side.Name))
                    {
                        <a class="side-agent" href="@($"agents/{agent.Id}")">
                            <span class="side-agent-icon" aria-hidden="true">@agent.Icon</span>
                            <span class="side-agent-text">
                                <span class="side-agent-name">@agent.Name</span>
                                <span class="side-agent-persona">@agent.Persona</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section id="agents" class="home-section" aria-labelledby="agents-title">
    <div class="section-head">
        <h2 id="agents-title">AI agents</h2>
        <p>Open an agent to try it on a Client Case. Each one supports a named person on the team.</p>
    </div>
    <div class="agent-grid">
        @foreach (var (agent, index) in AgentCatalog.All.Select((a, i) => (a, i + 1)))
        {
            <a class="agent-card" href="@($"agents/{agent.Id}")" style="--accent: @agent.Accent; --side: @PracticeSides.ColourFor(agent.Side)">
                <div class="agent-card-top">
                    <span class="agent-card-icon" aria-hidden="true">@agent.Icon<span class="agent-card-num">@index</span></span>
                    <span class="agent-card-dept">@agent.Department</span>
                </div>
                <h3>@agent.Name</h3>
                <div class="agent-card-persona">@agent.Persona</div>
                <p>@agent.Tagline</p>
                <div class="agent-card-tags">
                    <span class="agent-card-side">@agent.Side</span>
                    <span class="agent-card-stage">@(agent.Stages.Count == AgentCatalog.Lifecycle.Count ? "All stages" : string.Join(" · ", agent.Stages))</span>
                </div>
                <span class="agent-card-cta">Open agent <span aria-hidden="true">→</span></span>
            </a>
        }
    </div>
</section>

<section class="home-section" aria-labelledby="approvals-title">
    <div class="approvals-card">
        <div class="approvals-head">
            <h2 id="approvals-title">People approve</h2>
            <p>Agents never give personal advice. Amelia, Caldova's senior risk adviser, gives the advice — and a person approves:</p>
        </div>
        <ul class="approvals-list">
            @foreach (var approval in Approvals)
            {
                <li>@approval</li>
            }
        </ul>
    </div>
</section>

@code {
    private sealed record SideInfo(string Name, string Covers, string Team, string AgentsLabel);

    private static readonly SideInfo[] Sides =
    {
        new(PracticeSides.ClaimsAndCare, "Existing clients: reviews, changes and claims.", "Ben, Cara and Felix", "Dedicated agent"),
        new(PracticeSides.Shared, "Every request comes in through Olivia, and Theo leads both teams.", "Olivia and Theo", "Shared agents"),
        new(PracticeSides.ProtectionAdvice, "New advice: personal, family and business protection.", "Penny, Ivy and Uma", "Dedicated agents"),
    };

    private static readonly string[] Approvals =
    {
        "Every Statement of Advice and Record of Advice — Amelia signs it.",
        "Replacing or cancelling any existing cover.",
        "Accepting a loading, an exclusion or a decline at underwriting.",
        "Lodging any claim, and every death or terminal illness claim.",
        "Blocking a request on financial-crime grounds, and referring suspected fraud to an insurer.",
        "Any change to policy ownership, beneficiaries or bank details.",
        "Advice with total cover of $2,000,000 or more on one case — a second review.",
        "Complaint responses.",
        "Any message to a fraud victim, a seriously ill client or a bereaved family.",
    };

    private static string StageDescription(string stage) => stage switch
    {
        "Discover" => "Capture the request and the fact find, and open the Client Case.",
        "Verify" => "In-good-order checklist, identity and documents, fraud and scam checks.",
        "Advise" => "Needs analysis, insurer research and the Statement of Advice for Amelia.",
        "Implement" => "Underwriting and policy issue — or the claim, lodged after approval.",
        "Confirm" => "Plain-English letters and updates for clients, families and referral partners.",
        _ => string.Empty,
    };

    // Outcomes end with a status emoji (e.g. "Completed ✅"); the status pill carries that meaning instead.
    private static string CleanOutcome(string outcome) =>
        Regex.Replace(outcome, @"[\s\p{So}\p{Cs}\p{Mn}]+$", string.Empty);

    private static string StatusClass(string outcome) =>
        outcome.Contains("block", StringComparison.OrdinalIgnoreCase) ? "is-blocked"
        : outcome.Contains("partial", StringComparison.OrdinalIgnoreCase) ? "is-partial"
        : "is-done";
}

<style>
    /* ── Hero — light teal-to-ivory wash with navy type ──────────────── */
    .home-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(320px, 1fr);
        gap: 2.75rem;
        align-items: center;
        padding: 2.75rem 3rem;
        border-radius: 24px;
        color: var(--cw-text);
        border: 1px solid var(--cw-line);
        background:
            radial-gradient(ellipse 55% 85% at 100% 0%, rgba(20, 184, 166, 0.16), transparent 62%),
            linear-gradient(135deg, #e7f4f2 0%, #f2f7f7 55%, #fbf8f1 100%);
    }
    /* Concentric gold hairline rings — a nod to the copper dome on Caldova House. */
    .home-hero::before,
    .home-hero::after {
        content: "";
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        pointer-events: none;
    }
    .home-hero::before {
        right: -220px;
        bottom: -400px;
        width: 640px;
        height: 640px;
        border: 1px solid rgba(201, 161, 74, 0.45);
    }
    .home-hero::after {
        right: -340px;
        bottom: -520px;
        width: 880px;
        height: 880px;
        border: 1px solid rgba(201, 161, 74, 0.25);
    }

    .hero-eyebrow {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--cw-gold-ink);
        margin-bottom: 1rem;
    }

    .home-hero h1 {
        margin: 0 0 1rem 0;
        font-size: clamp(2.1rem, 3.4vw, 3.15rem);
        line-height: 1.1;
        color: var(--cw-ink);
        max-width: 40rem;
    }
    .home-hero h1 .hl {
        color: var(--cw-primary);
        font-style: italic;
    }

    .hero-lead {
        margin: 0;
        max-width: 40rem;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--cw-text-2);
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.5rem; }
    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        height: 44px;
        padding: 0 1.35rem;
        border-radius: 999px;
        font-size: 0.93rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .hero-btn:hover { text-decoration: none; }
    .hero-btn-solid { background: var(--cw-primary); color: #fff; border: 1.5px solid var(--cw-primary); }
    .hero-btn-solid:hover { background: var(--cw-primary-hover); border-color: var(--cw-primary-hover); color: #fff; }
    .hero-btn-outline { background: #fff; color: var(--cw-navy-800); border: 1.5px solid var(--cw-navy-800); }
    .hero-btn-outline:hover { background: var(--cw-navy-800); color: #fff; }

    /* White "case board" card on the light hero. */
    .hero-board {
        background: #fff;
        border: 1px solid var(--cw-line);
        border-radius: 20px;
        padding: 1.1rem 1.1rem 0.9rem 1.1rem;
        box-shadow: var(--cw-shadow-lg);
    }
    .hero-board-head {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0 0.35rem 0.8rem 0.35rem;
        border-bottom: 1px solid var(--cw-line);
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--cw-ink);
    }
    .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--cw-teal);
        box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.18);
    }
    .hero-board-count {
        margin-left: auto;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--cw-text-2);
        background: var(--cw-surface-2);
        border: 1px solid var(--cw-line);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
    }
    .hero-board-list {
        list-style: none;
        margin: 0.5rem 0 0.4rem 0;
        padding: 0;
    }
    .hero-board-list a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.4rem;
        border-radius: 12px;
        color: var(--cw-ink);
        text-decoration: none;
        transition: background 0.15s ease;
    }
    .hero-board-list a:hover { background: var(--cw-surface-2); text-decoration: none; }
    .hb-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--cw-surface-2);
        border: 1px solid var(--cw-line);
        font-size: 1rem;
    }
    .hb-body { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
    .hb-name { font-weight: 600; font-size: 0.92rem; }
    .hb-meta {
        font-size: 0.76rem;
        color: var(--cw-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .hb-status {
        margin-left: auto;
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        white-space: nowrap;
    }
    .hb-status.is-done { color: var(--cw-success); background: #e6f4ee; }
    .hb-status.is-partial { color: var(--cw-warn); background: #fdf1e1; }
    .hb-status.is-blocked { color: var(--cw-danger); background: #fdeceb; }

    /* ── Sections ─────────────────────────────────────────────────────── */
    .home-section { margin-top: 2.75rem; }
    .section-head { max-width: 46rem; margin-bottom: 1.25rem; }
    .section-head h2 {
        margin: 0 0 0.35rem 0;
        font-size: clamp(1.5rem, 2.2vw, 1.9rem);
        line-height: 1.2;
    }
    .section-head p {
        margin: 0;
        color: var(--cw-muted);
        font-size: 1rem;
        line-height: 1.6;
    }

    /* ── Lifecycle strip ──────────────────────────────────────────────── */
    .lifecycle-strip {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.8rem;
        counter-reset: none;
    }
    .lifecycle-stage {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        padding: 1rem 1rem 1.05rem 1rem;
        background: #fff;
        border: 1px solid var(--cw-line);
        border-top: 3px solid var(--cw-teal);
        border-radius: 14px;
        box-shadow: var(--cw-shadow-sm);
    }
    .lifecycle-stage:not(:last-child)::after {
        content: "→";
        position: absolute;
        right: -0.72rem;
        top: 1.05rem;
        z-index: 1;
        width: 1.3rem;
        height: 1.3rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--cw-navy-800);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
    }
    .lifecycle-stage-head { display: flex; align-items: center; gap: 0.5rem; }
    .lifecycle-num {
        width: 1.55rem;
        height: 1.55rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--cw-primary-soft);
        color: var(--cw-primary);
        font-size: 0.78rem;
        font-weight: 700;
    }
    .lifecycle-name { font-family: var(--cw-font-serif); font-size: 1.15rem; font-weight: 600; color: var(--cw-ink); }
    .lifecycle-desc { margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--cw-text-2); }
    .lifecycle-agents { display: flex; flex-direction: column; gap: 0.35rem; margin-top: auto; }
    .lifecycle-agent {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.6rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--cw-ink);
        text-decoration: none;
        background: color-mix(in srgb, var(--accent) 10%, #fff);
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .lifecycle-agent:hover { text-decoration: none; color: var(--cw-ink); background: color-mix(in srgb, var(--accent) 18%, #fff); }
    .lifecycle-oversight {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin-top: 0.8rem;
        padding: 0.75rem 1rem;
        border-radius: 14px;
        background: color-mix(in srgb, var(--cw-lilac) 10%, #fff);
        border: 1px dashed color-mix(in srgb, var(--cw-lilac) 60%, transparent);
        color: var(--cw-text);
        font-size: 0.9rem;
        text-decoration: none;
    }
    .lifecycle-oversight:hover { text-decoration: none; color: var(--cw-ink); background: color-mix(in srgb, var(--cw-lilac) 16%, #fff); }

    /* ── Two sides ────────────────────────────────────────────────────── */
    .sides-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }
    .side-card {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 1.25rem 1.3rem;
        background: #fff;
        border: 1px solid var(--cw-line);
        border-top: 4px solid var(--side);
        border-radius: 16px;
        box-shadow: var(--cw-shadow-sm);
    }
    .side-card-head { display: flex; align-items: center; gap: 0.55rem; }
    .side-card-head h3 { margin: 0; font-size: 1.1rem; color: var(--cw-ink); }
    .side-swatch { width: 14px; height: 14px; border-radius: 4px; background: var(--side); }
    .side-covers { margin: 0; color: var(--cw-text-2); font-size: 0.92rem; line-height: 1.5; }
    .side-team { font-size: 0.88rem; color: var(--cw-text); }
    .side-team .k,
    .side-agents-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--cw-muted);
        margin-bottom: 0.15rem;
    }
    .side-agents { display: flex; flex-direction: column; gap: 0.4rem; }
    .side-agent {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.6rem;
        border-radius: 12px;
        background: color-mix(in srgb, var(--side) 9%, #fff);
        border: 1px solid color-mix(in srgb, var(--side) 30%, transparent);
        color: var(--cw-ink);
        text-decoration: none;
    }
    .side-agent:hover { text-decoration: none; color: var(--cw-ink); background: color-mix(in srgb, var(--side) 16%, #fff); }
    .side-agent-icon { font-size: 1.1rem; }
    .side-agent-text { display: flex; flex-direction: column; line-height: 1.3; }
    .side-agent-name { font-weight: 600; font-size: 0.9rem; }
    .side-agent-persona { font-size: 0.78rem; color: var(--cw-muted); }

    /* ── Agent cards ──────────────────────────────────────────────────── */
    .agent-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 1.1rem;
    }
    .agent-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 1.35rem 1.35rem 1.2rem 1.35rem;
        background: #fff;
        border: 1px solid var(--cw-line);
        border-radius: 18px;
        color: var(--cw-text);
        text-decoration: none;
        box-shadow: var(--cw-shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .agent-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--cw-primary) 35%, var(--cw-line));
        box-shadow: var(--cw-shadow-lg);
        text-decoration: none;
        color: var(--cw-text);
    }
    .agent-card-top { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
    .agent-card-icon {
        position: relative;
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
        font-size: 1.35rem;
        background: color-mix(in srgb, var(--accent) 12%, #fff);
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    }
    /* Position in the request journey (onboarding → … → team leader). */
    .agent-card-num {
        position: absolute;
        top: -7px;
        left: -7px;
        min-width: 20px;
        height: 20px;
        padding: 0 5px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: var(--cw-navy-800);
        color: #fff;
        font-family: var(--cw-font-sans);
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 1;
        box-shadow: 0 0 0 2px #fff;
    }
    .agent-card-dept {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: color-mix(in srgb, var(--accent) 60%, var(--cw-ink));
    }
    .agent-card h3 {
        margin: 0 0 0.2rem 0;
        font-size: 1.12rem;
        font-weight: 650;
        color: var(--cw-ink);
    }
    .agent-card-persona { font-size: 0.84rem; color: var(--cw-muted); margin-bottom: 0.65rem; }
    .agent-card p { margin: 0 0 0.85rem 0; font-size: 0.93rem; line-height: 1.55; color: var(--cw-text); }
    .agent-card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.9rem; }
    .agent-card-side,
    .agent-card-stage {
        font-size: 0.7rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.12rem 0.55rem;
    }
    .agent-card-side {
        color: var(--cw-ink);
        background: color-mix(in srgb, var(--side) 16%, #fff);
        border: 1px solid color-mix(in srgb, var(--side) 45%, transparent);
    }
    .agent-card-stage {
        color: var(--cw-text-2);
        background: var(--cw-surface-2);
        border: 1px solid var(--cw-line);
    }
    .agent-card-cta {
        margin-top: auto;
        font-size: 0.88rem;
        font-weight: 600;
